[Unit]
Description=UntrashOS: data partition ut-data (way A) at /i-data/utdata
ConditionKernelCommandLine=!untrash.installer=1
ConditionPathExists=/dev/disk/by-partlabel/ut-data
After=local-fs.target untrash-zyxel.service systemd-udev-settle.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/untrash/untrash-data-mount
ExecStop=/bin/umount /i-data/utdata

[Install]
WantedBy=multi-user.target
