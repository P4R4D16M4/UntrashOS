[Unit]
Description=UntrashOS installer: network name untrash (DHCP, mDNS)
# installer-plan.md: the installer is reachable as untrash(.local); with another
# "untrash" in the network Avahi answers as untrash-2.local.
# Kernel hostname only (the stick system keeps no state); set before the
# network and Avahi start, so DHCP and mDNS announce this name.
ConditionKernelCommandLine=untrash.installer=1
DefaultDependencies=no
After=systemd-remount-fs.service
Before=network-pre.target avahi-daemon.service systemd-networkd.service
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/bin/hostname untrash

[Install]
WantedBy=sysinit.target
