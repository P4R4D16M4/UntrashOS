#!/usr/bin/python3
"""untrash-installer - first-time setup of UntrashOS in the browser.

docs/architecture/installer-plan.md.  Serves http://untrash/ (port 80,
or ZT_INSTALLER_PORT).  Four ways:
  A  new install, wipe the selected disk          (COPY key confirmation)
  B  keep the data, take over stock users/shares  (COPY key confirmation)
  C  keep the data, new users/configuration       (COPY key confirmation)
  D  back to the stock firmware from the stick's backup (COPY key; reboot,
     loader RAM mark, stock PartnerKey restores and powers off)

Every destructive run first backs up the partition table and the RAID/LVM
metadata of the affected disk to the stick.  B/C never
repartition: UntrashOS goes as files into /.untrash/ of a stock volume
(slot-a/b.utslot, state.img, swap.img, bootstate); the loader boots from there.  ZT_INSTALLER_DRYRUN=1 only logs
the commands; ZT_INSTALLER_TEST=1 also lists loop devices (self-tests).
"""
import datetime
import glob
import hashlib
import html
import json
import os
import re
import select
import shlex
import struct
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

DRYRUN = os.environ.get("ZT_INSTALLER_DRYRUN") == "1"
TEST = os.environ.get("ZT_INSTALLER_TEST") == "1"
PORT = int(os.environ.get("ZT_INSTALLER_PORT", "80"))
STICK_MNT = "/run/untrash/stick"
RUNDIR = os.environ.get("ZT_INSTALLER_RUNDIR", "/run/untrash/installer")   # tmpfs scratch
if TEST:  # self-tests: stock disks are partitioned loop devices (every importer call)
    os.environ.setdefault("ZT_IMPORT_DEVGLOB", "/dev/loop*p[0-9]")
IMPORT = os.environ.get("ZT_IMPORT_TOOL", "/usr/sbin/untrash-import-zyxel")
KEY_PROG1 = 148          # NAS542 COPY button (gpio-keys-polled, DT label "copy")
COPY_WAIT = 60
BOOTSTATE = b"ZTBS1 pref=a a=3 b=3 good=- booting=-\n"
LAYOUT = [  # sgdisk, firmware loader/slot/mkgpt.sh
    ["-a", "2048", "-n", "1:0:+1G", "-t", "1:8300", "-c", "1:ut-sys-a",
     "-n", "2:0:+1G", "-t", "2:8300", "-c", "2:ut-sys-b",
     "-n", "3:0:+4G", "-t", "3:8300", "-c", "3:ut-state",
     "-n", "4:0:+1G", "-t", "4:8200", "-c", "4:ut-swap",
     "-n", "5:0:0", "-t", "5:fd00", "-c", "5:ut-data"],
    ["-a", "8", "-n", "6:40:2047", "-t", "6:8300", "-c", "6:ut-bootstate"],
]
MIN_DISK = 16 * 1024 ** 3
# ways B/C: UntrashOS as files in /.untrash/ of a stock volume
STATE_IMG = 4 * 1024 ** 3
SWAP_IMG = 1024 ** 3
TARGET_MNT = "/run/untrash/target"


def sh(cmd, check=True, input=None):
    r = subprocess.run(cmd, input=input, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    out = r.stdout.decode("utf-8", "replace")
    if check and r.returncode:
        raise RuntimeError("%s -> %d: %s" % (" ".join(cmd), r.returncode, out.strip()[-400:]))
    return out


# ------------------------------------------------------------------ discovery

def lsblk():
    cols = "NAME,PATH,SIZE,TYPE,TRAN,MODEL,SERIAL,PARTLABEL,FSTYPE,PTTYPE,MOUNTPOINT,RO"
    return json.loads(sh(["lsblk", "-J", "-b", "-o", cols]))["blockdevices"]


def root_disk():
    """Disk that holds the running root (never offered for wiping)."""
    src = sh(["findmnt", "-no", "SOURCE", "/"], check=False).strip()
    dev = os.path.realpath(src) if src.startswith("/dev/") else ""
    name = os.path.basename(dev)
    slaves = glob.glob("/sys/class/block/%s/slaves/*" % name) if name else []
    for s in slaves or ([dev] if dev else []):
        part = os.path.basename(s)
        parent = os.path.basename(os.path.dirname(os.path.realpath("/sys/class/block/" + part)))
        if parent != "block":
            return parent
    return None


def find_stick():
    if TEST and os.environ.get("ZT_INSTALLER_STICKDIR"):
        d = os.environ["ZT_INSTALLER_STICKDIR"]
        return {"disk": "test", "dev": d, "mnt": d, "size": 0, "model": "test directory", "fake": True}
    for d in lsblk():
        if d.get("tran") != "usb":
            continue
        for p in d.get("children") or []:
            if p.get("fstype") != "vfat":
                continue
            mnt = p.get("mountpoint") or STICK_MNT
            if not p.get("mountpoint"):
                os.makedirs(STICK_MNT, exist_ok=True)
                if subprocess.run(["mount", "-o", "ro", p["path"], STICK_MNT]).returncode:
                    continue
            if os.path.isdir(os.path.join(mnt, "UNTRASH")):
                return {"disk": d["name"], "dev": p["path"], "mnt": mnt,
                        "size": d["size"], "model": (d.get("model") or "").strip()}
            if not p.get("mountpoint"):
                subprocess.run(["umount", STICK_MNT])
    return None


def stick_rw(stick, rw):
    if not DRYRUN and not stick.get("fake"):
        sh(["mount", "-o", "remount," + ("rw" if rw else "ro"), stick["mnt"]])


def stick_backups(stick):
    """install-*/update-*/rollback-* runs of the PartnerKey with a flash backup.
    "stock": an install run that completed (device.env + RESULT DONE): its
    backup is the stock state way D returns to.  "verified": the PartnerKey
    re-read the backup from the stick against SHA256SUMS (flash/VERIFIED)."""
    out = []
    for d in sorted(glob.glob(os.path.join(stick["mnt"], "UNTRASH", "*-2*"))):
        flash = os.path.join(d, "flash")
        sums = os.path.join(flash, "SHA256SUMS")
        if not os.path.isfile(sums):
            continue
        name = os.path.basename(d)
        dev = {}
        try:
            for line in open(os.path.join(d, "device.env")):
                k, _, v = line.strip().partition("=")
                dev[k] = v
        except OSError:
            pass
        try:
            done = "RESULT DONE" in open(os.path.join(d, "install.log"), errors="replace").read()
        except OSError:
            done = False
        out.append({"name": name, "dir": d, "flash": flash, "device": dev,
                    "files": len([l for l in open(sums) if l.strip()]),
                    "verified": os.path.isfile(os.path.join(flash, "VERIFIED")),
                    "stock": name.startswith("install-") and done and bool(dev)})
    return out


def stick_markers(stick):
    u = os.path.join(stick["mnt"], "UNTRASH")
    return {m: open(os.path.join(u, m), errors="replace").read().strip()
            for m in ("INSTALL_DONE", "INSTALL_FAILED", "ROLLBACK", "ROLLBACK_DONE", "ROLLBACK_FAILED")
            if os.path.isfile(os.path.join(u, m))} if stick else {}


def stock_config_dir(stick):
    """Stock /etc/zyxel saved on the stick, newest run first:
    UNTRASH/<install|update>-<stamp>/etc-zyxel.tar (+ .sha256, written by the
    PartnerKey script under stock; unpacked once to RUNDIR) or an unpacked
    UNTRASH/*/etc-zyxel/ directory."""
    if not stick:
        return None
    runs = glob.glob(os.path.join(stick["mnt"], "UNTRASH", "*-2*", "etc-zyxel.tar")) + \
        glob.glob(os.path.join(stick["mnt"], "UNTRASH", "*", "etc-zyxel"))
    for src in sorted(runs, key=lambda p: os.path.basename(os.path.dirname(p)).split("-", 1)[-1], reverse=True):
        if os.path.isdir(src):
            if os.path.isfile(os.path.join(src, "ugs_conf.db")):
                return src
            continue
        try:
            want = open(src + ".sha256").read().split()[0]
        except (OSError, IndexError):
            continue
        dst = os.path.join(RUNDIR, "stock-config", os.path.basename(os.path.dirname(src)))
        if os.path.isfile(os.path.join(dst, "ugs_conf.db")):
            return dst
        h = hashlib.sha256()
        with open(src, "rb") as f:
            for b in iter(lambda: f.read(1 << 20), b""):
                h.update(b)
        if h.hexdigest() != want:
            print("stock config %s: sha256 mismatch, ignored" % src, flush=True)
            continue
        tmp = dst + ".tmp"
        sh(["rm", "-rf", tmp])
        os.makedirs(tmp, mode=0o700)
        sh(["tar", "-xf", src, "-C", tmp])
        if os.path.isfile(os.path.join(tmp, "ugs_conf.db")):
            os.replace(tmp, dst)
            return dst
        sh(["rm", "-rf", tmp])
    return None


def classify(d):
    parts = d.get("children") or []
    labels = {p.get("partlabel") or "" for p in parts}
    if {"ut-sys-a", "ut-state"} <= labels:
        return "untrash"
    if any(p.get("fstype") == "linux_raid_member" for p in parts):
        return "stock" if len(parts) >= 3 else "raid"
    if not parts and not d.get("pttype") and not d.get("fstype"):
        return "empty"
    return "foreign"


def scan():
    stick = find_stick()
    rootd = root_disk()
    disks = []
    for d in lsblk():
        if d.get("type") not in (("disk", "loop") if TEST else ("disk",)) or d.get("tran") == "usb" or d["name"].startswith(("mtd", "ram", "zram")):
            continue
        if d["name"].startswith("loop") and not TEST:
            continue
        if d["name"].startswith("loop") and not int(d.get("size") or 0):
            continue
        disks.append({"name": d["name"], "path": d["path"], "size": d["size"],
                      "model": (d.get("model") or "").strip(), "serial": (d.get("serial") or "").strip(),
                      "kind": classify(d), "system": d["name"] == rootd,
                      "parts": [{"name": p["name"], "size": p["size"], "label": p.get("partlabel"),
                                 "fs": p.get("fstype")} for p in d.get("children") or []]})
    arrays = []
    r = subprocess.run([IMPORT, "volumes"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    if r.returncode == 0:
        try:
            arrays = json.loads(r.stdout or "[]")
        except ValueError:
            arrays = []
    cfg = stock_config_dir(stick)
    return {"stick": stick, "backups": stick_backups(stick) if stick else [], "markers": stick_markers(stick),
            "slot": slot_source(stick), "disks": disks, "stock_arrays": arrays,
            "stock_config": cfg, "import_plan": import_plan(cfg)}


def import_plan(cfg):
    if not cfg:
        return None
    r = subprocess.run([IMPORT, "plan", cfg], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    return r.stdout.decode("utf-8", "replace")


def slot_source(stick):
    """System slot on the stick, UNTRASH/system/ (firmware install/mk-stick-system.sh):
    slot.utslot (head + trailer) or the older slot.head.gz + slot.trailer;
    slot.sha256 lines "<sha256> <name>", "<bytes> slot.head.length"."""
    if not stick:
        return None
    d = os.path.join(stick["mnt"], "UNTRASH", "system")
    sums_f = os.path.join(d, "slot.sha256")
    if not os.path.isfile(sums_f):
        return None
    sums = dict(l.split()[::-1] for l in open(sums_f) if l.strip())
    src = {"dir": d, "sums": sums,
           "version": open(os.path.join(d, "version")).read().strip()
           if os.path.isfile(os.path.join(d, "version")) else "?"}
    if os.path.isfile(os.path.join(d, "slot.utslot")):
        src["utslot"] = os.path.join(d, "slot.utslot")
        src["size"] = os.path.getsize(src["utslot"])
        return src
    need = [os.path.join(d, n) for n in ("slot.head.gz", "slot.trailer")]
    if not all(os.path.isfile(n) for n in need):
        return None
    src["head"], src["trailer"] = need
    return src


# ------------------------------------------------------------------- runner

class Job:
    def __init__(self):
        self.lock = threading.Lock()
        self.state = "idle"     # idle | waiting-copy | running | done | failed
        self.mode = None
        self.log = []
        self.copy_deadline = 0

    def add(self, line):
        stamp = datetime.datetime.now().strftime("%H:%M:%S")
        with self.lock:
            self.log.append("%s %s" % (stamp, line))
        print(line, flush=True)

    def snapshot(self):
        with self.lock:
            return {"state": self.state, "mode": self.mode, "log": self.log[-400:],
                    "copy_left": max(0, int(self.copy_deadline - time.time()))
                    if self.state == "waiting-copy" else 0, "dryrun": DRYRUN}


JOB = Job()


def run(cmd, input=None):
    JOB.add("$ " + " ".join(shlex.quote(c) for c in cmd))
    if DRYRUN:
        return ""
    out = sh(cmd, input=input)
    for line in out.strip().splitlines()[-6:]:
        JOB.add("  " + line)
    return out


def wait_copy_key():
    """True when the COPY button is pressed within COPY_WAIT seconds."""
    if DRYRUN or os.environ.get("ZT_INSTALLER_NOKEY") == "1" and TEST:
        JOB.add("(Dry run: COPY button assumed pressed)")
        return True
    devs = []
    for ev in glob.glob("/dev/input/event*"):
        try:
            devs.append(open(ev, "rb", buffering=0))
        except OSError:
            pass
    fmt = "llHHi"
    size = struct.calcsize(fmt)
    try:
        while time.time() < JOB.copy_deadline:
            r, _, _ = select.select(devs, [], [], 1)
            for f in r:
                data = f.read(size * 64)
                for i in range(0, len(data) - size + 1, size):
                    _s, _u, typ, code, val = struct.unpack(fmt, data[i:i + size])
                    if typ == 1 and code == KEY_PROG1 and val == 1:
                        return True
        return False
    finally:
        for f in devs:
            f.close()


def backup_disk_meta(stick, disk, tag):
    """Partition table, md superblock areas and LVM metadata -> stick (level E)."""
    stamp = time.strftime("%Y%m%d-%H%M%S")
    out = os.path.join(stick["mnt"], "UNTRASH", "disk-backup-%s-%s-%s" % (tag, disk["name"], stamp))
    run(["mkdir", "-p", out])
    run(["dd", "if=" + disk["path"], "of=%s/head-1MiB.bin" % out, "bs=1M", "count=1", "status=none"])
    # the exact last MiB: the backup GPT sits in the last 33 sectors, and disk
    # sizes are rarely a multiple of 1 MiB
    run(["dd", "if=" + disk["path"], "of=%s/tail-1MiB.bin" % out, "bs=1M", "iflag=skip_bytes",
         "skip=%d" % (disk["size"] - 1024 * 1024), "count=1", "status=none"])
    for p in disk["parts"]:
        # md 1.2 superblock at 4 KiB, LVM label/metadata in the first MiB
        run(["dd", "if=/dev/" + p["name"], "of=%s/%s-head-1MiB.bin" % (out, p["name"]), "bs=1M", "count=1",
             "status=none"])
    if not DRYRUN:
        with open(os.path.join(out, "lsblk.json"), "w") as f:
            json.dump(disk, f, indent=1)
        with open(os.path.join(out, "sgdisk-backup.txt"), "w") as f:
            f.write(sh(["sgdisk", "-p", disk["path"]], check=False))
        sh(["sh", "-c", "cd %s && sha256sum *.bin > SHA256SUMS" % shlex.quote(out)])
    JOB.add("Disk metadata backup: %s" % out)


def write_slot(slot, part):
    hlen = int(slot["sums"]["slot.head.length"])
    if "utslot" in slot:
        run(["dd", "if=" + slot["utslot"], "of=" + part, "bs=4096", "count=%d" % (hlen // 4096),
             "conv=fsync", "status=none"])
    else:
        run(["sh", "-c", "zcat %s | dd of=%s bs=1M conv=fsync status=none" % (shlex.quote(slot["head"]), part)])
    blocks = int(sh(["blockdev", "--getsize64", part]).strip()) // 4096 if not DRYRUN else 262144
    if "utslot" in slot:
        run(["dd", "if=" + slot["utslot"], "of=" + part, "bs=4096", "skip=%d" % (hlen // 4096),
             "seek=%d" % (blocks - 2), "count=2", "conv=fsync", "status=none"])
    else:
        run(["dd", "if=" + slot["trailer"], "of=" + part, "bs=4096", "seek=%d" % (blocks - 2), "conv=fsync",
             "status=none"])
    if DRYRUN:
        return
    want_head = slot["sums"]["slot.head"]
    h = hashlib.sha256()
    with open(part, "rb") as f:
        left = hlen
        while left:
            b = f.read(min(left, 1 << 20))
            h.update(b)
            left -= len(b)
        f.seek((blocks - 2) * 4096)
        t = hashlib.sha256(f.read(8192)).hexdigest()
    if h.hexdigest() != want_head or t != slot["sums"]["slot.trailer"]:
        raise RuntimeError("Read-back of %s does not match (head %s, trailer %s)" % (part, h.hexdigest()[:12], t[:12]))
    JOB.add("Slot %s read back: identical (%d MB)" % (part, hlen // 1000000))


def clear_install_marker(stick):
    """The loader boots the installer while UNTRASH/INSTALL is on the stick."""
    marker = os.path.join(stick["mnt"], "UNTRASH", "INSTALL")
    if not os.path.exists(marker):
        return
    stick_rw(stick, True)
    try:
        run(["rm", "-f", marker])
    finally:
        stick_rw(stick, False)
    JOB.add("Marker UNTRASH/INSTALL removed: the next start boots the installed system")


def part_of(disk_path, n):
    base = disk_path + ("p%d" % n if disk_path[-1].isdigit() else "%d" % n)
    return base


def do_wipe_install(req, info):
    disk = next(d for d in info["disks"] if d["name"] == req["disk"])
    stick, slot = info["stick"], info["slot"]
    stick_rw(stick, True)
    try:
        backup_disk_meta(stick, disk, "A")
    finally:
        stick_rw(stick, False)
    run([IMPORT, "release"])
    for md in sorted(glob.glob("/sys/class/block/md*")):
        slaves = [os.path.basename(s) for s in glob.glob(md + "/slaves/*")]
        if any(s.startswith(disk["name"]) for s in slaves):
            run(["mdadm", "--stop", "/dev/" + os.path.basename(md)])
    for p in disk["parts"]:
        run(["wipefs", "-a", "/dev/" + p["name"]])
    run(["sgdisk", "-Z", disk["path"]])
    for args in LAYOUT:
        run(["sgdisk"] + args + [disk["path"]])
    run(["partprobe", disk["path"]])
    run(["udevadm", "settle"])
    for n in (1, 2):
        write_slot(slot, part_of(disk["path"], n))
    run(["dd", "of=" + part_of(disk["path"], 6), "bs=512", "count=1", "conv=fsync,sync", "status=none"],
        input=BOOTSTATE)
    rec = device_record(info)
    if rec:
        run(["dd", "of=" + part_of(disk["path"], 6), "bs=4096", "seek=1", "count=1", "conv=fsync,sync",
             "status=none"], input=rec)
        JOB.add("Stock MAC addresses taken over")
    else:
        JOB.add("No stock MAC addresses on the stick: UntrashOS uses the driver's")
    run(["mkfs.btrfs", "-f", "-L", "ut-data", part_of(disk["path"], 5)])
    run(["wipefs", "-a", part_of(disk["path"], 3)])   # fresh state: no leftovers of the old disk content
    seed_state(part_of(disk["path"], 3))
    clear_install_marker(stick)
    JOB.add("Done: restarting starts UntrashOS %s from %s" % (slot["version"], disk["name"]))


MAC_RE = re.compile(r"^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$")


def device_record(info):
    """Stock MACs and stock kernel slot of this NAS (PartnerKey device.env of
    the newest completed install run) as the text UntrashOS reads at boot
    (untrash-init: way A in block 1 of ut-bootstate, ways B/C in
    /.untrash/device.env).  ACTIVE_SLOT tells untrash-pfe-firmware which
    kernel partition holds the stock kernel with the PFE firmware."""
    for b in reversed(info["backups"]):
        if b["stock"]:
            lines = ["%s=%s" % (k, b["device"].get(k, "")) for k in ("ETH0_MAC", "ETH1_MAC")
                     if MAC_RE.match(b["device"].get(k, ""))]
            if b["device"].get("ACTIVE_SLOT") in ("1", "2"):
                lines.append("ACTIVE_SLOT=%s" % b["device"]["ACTIVE_SLOT"])
            if lines:
                return ("\n".join(lines) + "\n").encode()
    return None


PFE_CACHE = os.environ.get("ZT_INSTALLER_PFE", "/state/firmware/pfe")   # untrash-init of this run
SEED_MNT = "/run/untrash/seed-state"


def seed_state(target):
    """Put the PFE PE firmware this installer runs with (untrash-init took it
    from the stock kernel copy on the stick) into the state of the installed
    system (ut-state partition or /.untrash/state.img), so that system never
    has to read the NAND for it.  An empty target becomes ext4 ut-state,
    exactly as untrash-init would format it; a non-ext4 one is left alone."""
    if not DRYRUN and not os.path.isfile(os.path.join(PFE_CACHE, "class_c2000.elf")):
        JOB.add("No PFE firmware in the installer: the system reads it itself on first start")
        return
    if DRYRUN or sh(["wipefs", "-n", target], check=False).strip() == "":
        run(["mkfs.ext4", "-q", "-F", "-L", "ut-state", "-E", "lazy_itable_init=1,lazy_journal_init=1", target])
    elif sh(["blkid", "-p", "-o", "value", "-s", "TYPE", target], check=False).strip() != "ext4":
        JOB.add("State %s is not ext4: PFE firmware not stored" % target)
        return
    run(["mkdir", "-p", SEED_MNT])
    opts = "rw,noatime" + (",loop" if not target.startswith("/dev/") else "")
    run(["mount", "-t", "ext4", "-o", opts, target, SEED_MNT])
    try:
        run(["mkdir", "-p", os.path.join(SEED_MNT, "firmware")])
        run(["rm", "-rf", os.path.join(SEED_MNT, "firmware", "pfe")])
        run(["cp", "-a", PFE_CACHE, os.path.join(SEED_MNT, "firmware", "pfe")])
        run(["sync"])
    finally:
        run(["umount", SEED_MNT])
    JOB.add("PFE firmware stored in the system state")


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def do_stock_restore(req, info):
    """Way D with stick + browser only (firmware loader/slot/zt-loader "way D"): check the
    install run's backup, set UNTRASH/ROLLBACK, reboot.  The loader leaves a
    RAM mark and resets, Barebox then starts the stock firmware, whose
    PartnerKey writes env + kernel<X> back from this backup and powers off."""
    stick = info["stick"]
    b = next(x for x in info["backups"] if x["name"] == req["backup"])
    dev = b["device"]
    JOB.add("Checking backup %s ..." % b["name"])
    run(["sh", "-c", "cd %s && sha256sum -c --quiet SHA256SUMS" % shlex.quote(b["flash"])])
    for f, key in (("mtd2-before-a.bin", "ENV_OLD_SHA256"), ("mtd%s-before-a.bin" % dev["LOADER_MTD"], "KX_OLD_SHA256")):
        got = sha256_file(os.path.join(b["dir"], f)) if not DRYRUN else dev[key]
        if got != dev[key]:
            raise RuntimeError("%s/%s does not match the installation checksum" % (b["name"], f))
    JOB.add("Backup checked: env and kernel%s (stock state before the installation)" % dev["LOADER_SLOT"])
    u = os.path.join(stick["mnt"], "UNTRASH")
    stick_rw(stick, True)
    try:
        for m in ("ROLLBACK_FAILED", "ROLLBACK_DONE", "ROLLBACK_BUSY", "rollback-stage1.log"):
            if os.path.exists(os.path.join(u, m)):
                run(["mv", os.path.join(u, m), os.path.join(u, "%s.old-%s" % (m, time.strftime("%Y%m%d-%H%M%S")))])
        run(["touch", os.path.join(u, "ROLLBACK")])
        run(["sync"])
    finally:
        stick_rw(stick, False)
    JOB.add("Marker UNTRASH/ROLLBACK set. The NAS now restarts, starts the stock firmware once, "
            "writes env and kernel%s back from the backup and then powers off (a few minutes; "
            "the stick must stay in). Then power on: the NAS starts the stock firmware as before "
            "the installation." % dev["LOADER_SLOT"])
    if not DRYRUN and not TEST:
        threading.Timer(8.0, lambda: subprocess.run(["systemctl", "reboot"])).start()


def stock_volumes():
    """Stock data volumes, mounted read-only under /i-data by the importer:
    ({id, dev, mnt, name, kind, array, members, sysvol, free, untrash}, error).

    The installer used to turn every importer failure into an empty list.  That
    made an md/LVM/ext4 failure indistinguishable from a NAS with no data
    volume at all.  This call is still read-only: the importer assembles md
    with --readonly and mounts ext4 ro,noload.
    """
    r = subprocess.run([IMPORT, "volumes", "--mount"], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    try:
        arrays = json.loads(r.stdout or "[]") if r.returncode == 0 else None
    except ValueError:
        arrays = None
    if arrays is None:
        detail = r.stderr.decode("utf-8", "replace").strip()
        if not detail:
            detail = r.stdout.decode("utf-8", "replace").strip()
        # Keep the web response readable and never turn arbitrary command
        # output into markup (the client escapes every problem string).
        detail = " ".join(detail.split())[-600:] or "no details received"
        print("importer volumes --mount failed (rc %d): %s" % (r.returncode, detail), flush=True)
        return [], "Read-only check of RAID/LVM/file system failed: %s" % detail
    out = []
    for a in arrays:
        for v in a.get("volumes") or []:
            mnt = v.get("mnt")
            if not mnt or v.get("id") == "vg_info_area" or not v.get("mounted"):
                continue
            st = os.statvfs(mnt)
            out.append({"key": a["uuid"].replace(":", "")[:8] + "/" + v["id"], "id": v["id"], "dev": v["dev"], "mnt": mnt, "name": v.get("name") or v["id"],
                        "kind": "lvm" if v["id"] != "md" else "md", "array": a["uuid"], "level": a.get("level"),
                        "members": a["members"], "degraded": len(a["members"]) < int(a.get("devices") or 0),
                        "sysvol": bool(glob.glob(mnt + "/.system/sysvol_*")),
                        "free": st.f_bavail * st.f_frsize,
                        "untrash": os.path.isfile(os.path.join(mnt, ".untrash", "bootstate"))})
    if not out:
        unknown = []
        for a in arrays:
            for v in a.get("volumes") or []:
                if not v.get("mounted"):
                    unknown.append("%s (%s)" % (v.get("dev", "?"), v.get("type", "unknown")))
        if unknown:
            return [], "No mountable ext4 stock volume: %s" % ", ".join(unknown[:4])
    return sorted(out, key=lambda v: (not v["sysvol"], v["name"])), None


def need_bytes(slot, vol=None):
    """Free space needed on the volume; files of an earlier installation in
    /.untrash are replaced (slots) or kept (state, swap) and count as free."""
    need = 2 * slot.get("size", 0) + STATE_IMG + SWAP_IMG + 256 * 1024 ** 2
    for n in ("slot-a.utslot", "slot-b.utslot", "state.img", "swap.img"):
        try:
            need -= os.stat(os.path.join(vol["mnt"], ".untrash", n)).st_blocks * 512 if vol else 0
        except OSError:
            pass
    return max(need, 256 * 1024 ** 2)


def disks_of(members, info):
    names = {os.path.basename(m) for m in members}
    return [d for d in info["disks"] if any(p["name"] in names for p in d["parts"])]


def copy_verified(src, dst, want):
    """Copy src to dst (via dst.tmp + rename), then re-read dst from disk."""
    tmp = dst + ".tmp"
    run(["dd", "if=" + src, "of=" + tmp, "bs=1M", "conv=fsync", "status=none"])
    if DRYRUN:
        return
    os.replace(tmp, dst)
    with open("/proc/sys/vm/drop_caches", "w") as f:
        f.write("3\n")
    h = hashlib.sha256()
    with open(dst, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    if h.hexdigest() != want:
        raise RuntimeError("Read-back of %s does not match (%s)" % (dst, h.hexdigest()[:12]))
    JOB.add("%s read back: identical" % dst)


# ------------------------------------------------- way C: new configuration
# Way C writes a minimal configuration in the stock format (ugs_conf.db +
# py_conf) and stages it exactly like way B, so the installed system applies
# it with the same tested importer: user admin (uid 501, group everyone 500)
# with the password chosen here, guest pc-guest, one share per existing
# top-level folder of the volume, admin read/write.  Only hashes are stored.

SMB_BAD = re.compile(r'[\\/\[\]:|<>+=;,*?"\x00-\x1f]')
STOCK_SCHEMA = """
CREATE TABLE smb_user (uid integer PRIMARY KEY NOT NULL, uname TEXT NOT NULL, create_type TEXT, utype TEXT, passwd TEXT, description TEXT, UNIQUE (uname COLLATE NOCASE));
CREATE TABLE smb_group (gid integer PRIMARY KEY NOT NULL, gname TEXT NOT NULL, gtype TEXT, description TEXT, UNIQUE (gname COLLATE NOCASE));
CREATE TABLE group_member (gid integer, gname TEXT, uid integer, uname TEXT);
CREATE TABLE ugs_misc (key TEXT PRIMARY KEY NOT NULL, value TEXT);
CREATE TABLE smb_share (s_name TEXT primary key NOT NULL, s_path TEXT NOT NULL, create_type TEXT, s_desc TEXT, s_enable TEXT, browseable TEXT, recycle TEXT, mdaserv_public_type INT, web_public TEXT, UNIQUE (s_name COLLATE NOCASE));
CREATE TABLE share_user_privilege (s_name TEXT, uid INT, uname TEXT, privilege TEXT);
CREATE TABLE share_group_privilege (s_name TEXT, gid INT, gname TEXT, privilege TEXT);
"""


def md4(data):
    """RFC 1320 (hashlib has no MD4 with OpenSSL 3)."""
    def rol(x, n):
        x &= 0xffffffff
        return ((x << n) | (x >> (32 - n))) & 0xffffffff
    msg = bytearray(data) + b"\x80"
    msg += b"\x00" * ((56 - len(msg) % 64) % 64) + struct.pack("<Q", 8 * len(data))
    h = [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476]
    for off in range(0, len(msg), 64):
        X = struct.unpack("<16I", msg[off:off + 64])
        a, b, c, d = h
        for i in range(16):
            k, r = i, (3, 7, 11, 19)[i % 4]
            a, b, c, d = d, rol(a + ((b & c) | (~b & d)) + X[k], r), b, c
        for i in range(16):
            k, r = (i % 4) * 4 + i // 4, (3, 5, 9, 13)[i % 4]
            a, b, c, d = d, rol(a + ((b & c) | (b & d) | (c & d)) + X[k] + 0x5a827999, r), b, c
        for i in range(16):
            k, r = (0, 8, 4, 12, 2, 10, 6, 14, 1, 9, 5, 13, 3, 11, 7, 15)[i], (3, 9, 11, 15)[i % 4]
            a, b, c, d = d, rol(a + (b ^ c ^ d) + X[k] + 0x6ed9eba1, r), b, c
        h = [(x + y) & 0xffffffff for x, y in zip(h, (a, b, c, d))]
    return struct.pack("<4I", *h)


def new_shares(vol, root=None):
    """[(name, path)] = existing top-level folders of the volume, read at root
    (default: its read-only mount); path as the installed system sees it."""
    out, root = [], root or vol["mnt"]
    try:
        names = sorted(os.listdir(root), key=str.lower)
    except OSError:
        return out
    for n in names:
        if n.startswith(".") or n == "lost+found" or SMB_BAD.search(n) or len(n) > 80:
            continue
        if os.path.isdir(os.path.join(root, n)) and not os.path.islink(os.path.join(root, n)):
            out.append((n, os.path.join(vol["mnt"], n)))
    return out


def new_config_problems(req):
    pw, pw2 = req.get("password") or "", req.get("password2") or ""
    name = (req.get("netname") or "").strip()
    p = []
    if len(pw) < 8:
        p.append("The password for admin needs at least 8 characters.")
    elif pw != pw2:
        p.append("The two passwords do not match.")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]{0,14}", name):
        p.append("Network name: 1–15 characters, letters, digits and hyphen.")
    return p


def write_new_config(req, vol, dst, root):
    """ugs_conf.db + py_conf for way C into dst (a new directory)."""
    import sqlite3
    pw = req["password"]
    nt = md4(pw.encode("utf-16-le")).hex().upper()
    shadow = sh(["openssl", "passwd", "-6", "-stdin"], input=pw.encode()).strip()
    if not shadow.startswith("$6$"):
        raise RuntimeError("openssl passwd gave no SHA-512 hash")
    os.makedirs(dst, mode=0o700)
    c = sqlite3.connect(os.path.join(dst, "ugs_conf.db"))
    c.executescript(STOCK_SCHEMA)
    c.executemany("INSERT INTO smb_user VALUES (?,?,?,?,?,?)",
                  [(501, "admin", "bulit-in", "admin", "X" * 32 + ":" + nt, ""),
                   (502, "pc-guest", "bulit-in", "guest", "", "")])
    c.execute("INSERT INTO smb_group VALUES (500, 'everyone', 'local', 'System default group')")
    c.execute("INSERT INTO ugs_misc VALUES ('admin_shadow_passwd', ?)", (shadow,))
    shares = new_shares(vol, root)
    for name, path in shares:
        c.execute("INSERT INTO smb_share VALUES (?,?,'user-create','','y','y','n',0,'n')", (name, path))
        c.execute("INSERT INTO share_user_privilege VALUES (?,501,'admin','rw')", (name,))
    c.commit()
    c.close()
    with open(os.path.join(dst, "py_conf"), "w") as f:
        f.write("[system]\n    hostname = %s\n    [[servername]]\n        servername = %s\n"
                "        description = UntrashOS\n        workgroupname = WORKGROUP\n        nomaster = false\n" % (
                    req["netname"].strip().lower(), req["netname"].strip()))
    JOB.add("New configuration: user admin, %d share(s), name %s" % (
        len(shares), req["netname"].strip()))


def do_keep_install(req, info, takeover):
    """Ways B/C: system as files in /.untrash/ of a stock volume, nothing repartitioned."""
    vol = next(v for v in info["volumes"] if v["key"] == req["volume"])
    stick, slot = info["stick"], info["slot"]
    stick_rw(stick, True)
    try:
        for d in disks_of(vol["members"], info):
            backup_disk_meta(stick, d, "B" if takeover else "C")
    finally:
        stick_rw(stick, False)
    run([IMPORT, "release"])
    uuid8 = vol["array"].replace(":", "")[:8]
    md = "/dev/md/zyx-" + uuid8
    run(["mdadm", "--assemble", "--run", md] + vol["members"])
    vg = None
    try:
        dev = md
        if vol["kind"] == "lvm":
            vg = os.path.basename(os.path.dirname(vol["dev"]))
            run(["vgchange", "-ay", vg])
            dev = vol["dev"]
        r = subprocess.run(["e2fsck", "-p", dev]) if not DRYRUN else None
        if r is not None and r.returncode >= 4:
            raise RuntimeError("e2fsck %s reports errors (rc %d); please check first" % (dev, r.returncode))
        run(["mkdir", "-p", TARGET_MNT])
        run(["mount", "-t", "ext4", "-o", "rw,noatime", dev, TARGET_MNT])
        try:
            u = os.path.join(TARGET_MNT, ".untrash")
            run(["mkdir", "-p", "-m", "700", u])
            for x in ("a", "b"):
                copy_verified(slot["utslot"], os.path.join(u, "slot-%s.utslot" % x), slot["sums"]["slot.utslot"])
            if DRYRUN or not os.path.exists(os.path.join(u, "state.img")):
                run(["fallocate", "-l", str(STATE_IMG), os.path.join(u, "state.img")])
            else:
                JOB.add("state.img present: kept")
            seed_state(os.path.join(u, "state.img"))
            if DRYRUN or not os.path.exists(os.path.join(u, "swap.img")):
                run(["fallocate", "-l", str(SWAP_IMG), os.path.join(u, "swap.img")])
                run(["chmod", "600", os.path.join(u, "swap.img")])
                run(["mkswap", "-L", "ut-swap", os.path.join(u, "swap.img")])
            run(["dd", "of=" + os.path.join(u, "bootstate"), "bs=512", "count=1", "conv=fsync,sync",
                 "status=none"], input=BOOTSTATE)
            rec = device_record(info)
            if rec:
                run(["dd", "of=" + os.path.join(u, "device.env"), "conv=fsync", "status=none"], input=rec)
                JOB.add("Stock MAC addresses taken over")
            # B: the stock config from the stick; C: a new one (same format)
            cfg = info["stock_config"]
            if not takeover:
                cfg = os.path.join(RUNDIR, "new-config-%d" % os.getpid())
                if not DRYRUN:
                    sh(["rm", "-rf", cfg])
                    write_new_config(req, vol, cfg, TARGET_MNT)
            run(["rm", "-rf", os.path.join(u, "stock-config")])
            run(["cp", "-a", cfg, os.path.join(u, "stock-config")])
            run(["chmod", "700", os.path.join(u, "stock-config")])
            run(["touch", os.path.join(u, "takeover-pending")])
            # language chosen on this page: the installed system starts with it
            lang = req.get("lang") if req.get("lang") in ("en", "de", "fr") else "en"
            run(["sh", "-c", 'printf "%s\\n" "$1" >"$2"', "-", lang, os.path.join(u, "language")])
            run(["sync"])
        finally:
            run(["umount", TARGET_MNT])
    finally:
        if vg:
            run(["vgchange", "-an", vg])
        run(["mdadm", "--stop", md])
    clear_install_marker(stick)
    # two whole sentences, so the EN/FR catalogs can translate each (i18n.js patterns)
    JOB.add(("Done: restarting starts UntrashOS %s from /.untrash on “%s” and sets up the old users and "
             "shares on the first start" if takeover else
             "Done: restarting starts UntrashOS %s from /.untrash on “%s” and sets up admin and the shares on "
             "the first start") % (slot["version"], vol["name"]))


MODES = {
    "A": {"title": "new installation – erase the disk", "fn": do_wipe_install, "copy": True},
    "B": {"title": "new installation – keep the data, take over the old users and shares",
          "fn": lambda req, info: do_keep_install(req, info, True), "copy": True},
    "C": {"title": "new installation – keep the data, new users and settings",
          "fn": lambda req, info: do_keep_install(req, info, False), "copy": True},
    "D": {"title": "restore the stock firmware from the backup on the stick", "fn": do_stock_restore,
          "copy": True},
}


def plan(req, info):
    """(steps, problems, phrase) for a request; nothing is executed."""
    m = req.get("mode")
    steps, problems = [], []
    if m == "A":
        disk = next((d for d in info["disks"] if d["name"] == req.get("disk")), None)
        if not disk:
            problems.append("No disk selected.")
            return steps, problems, None
        if disk["system"]:
            problems.append("%s holds the running system and cannot be erased from here." % disk["name"])
        if disk["size"] < MIN_DISK:
            problems.append("%s is smaller than 16 GiB." % disk["name"])
        if not info["stick"]:
            problems.append("No UntrashOS stick found (needed for the disk metadata backup).")
        if not info["slot"]:
            problems.append("UNTRASH/system/ (system image) is missing on the stick.")
        steps = ["Back up the partition table and RAID/LVM metadata of %s to the stick" % disk["name"],
                 "Release the stock volumes, stop the RAID arrays of the disk",
                 "Erase ALL partitions and data on %s (%s, %.0f GB)" % (
                     disk["name"], disk["model"] or "?", disk["size"] / 1e9),
                 "Create the UntrashOS layout: ut-sys-a/b, ut-state, ut-swap, ut-data, ut-bootstate",
                 "Write system image %s to ut-sys-a and ut-sys-b and read it back" % (
                     info["slot"] or {}).get("version", "?"),
                 "Format the data area ut-data with btrfs",
                 "Confirm at the NAS: press the COPY button"]
        for a in info["stock_arrays"]:
            names = {os.path.basename(m) for m in a.get("members") or []}
            others = {p["name"] for p in disk["parts"]}
            if a.get("role") == "stock-data" and names & others and names - others:
                steps.insert(2, "Caution: the stock array %s (%s) loses a disk and is incomplete "
                                "afterwards" % (a.get("level"), a["uuid"][:8]))
        phrase = "DELETE %s" % disk["name"]
    elif m == "D":
        b = next((x for x in info["backups"] if x["name"] == req.get("backup")), None)
        if not b:
            problems.append("No stock backup on the stick selected.")
            return steps, problems, None
        if not b["stock"]:
            problems.append("%s is not a completed installation backup; the stock state is in the "
                            "install-* backup with device.env." % b["name"])
        # two whole sentences, so the EN/FR catalogs can translate each (i18n.js patterns)
        steps = [("Check the checksums of backup %s (%d files, read back when it was made)" if b["verified"]
                  else "Check the checksums of backup %s (%d files)") % (b["name"], b["files"]),
                 "Write the marker UNTRASH/ROLLBACK to the stick and restart",
                 "The NAS starts the stock firmware once; it writes env and kernel%s back from the backup "
                 "and powers off (leave the stick in)" % b["device"].get("LOADER_SLOT", "?"),
                 "Then power on: stock firmware as before the installation; data on the disks stays, the "
                 "UntrashOS files in /.untrash or the UntrashOS disk are left in place",
                 "Confirm at the NAS: press the COPY button"]
        phrase = "STOCK"
    elif m in ("B", "C"):
        vols, volume_error = stock_volumes()
        info["volumes"] = vols
        slot = info["slot"] or {}
        if not vols:
            problems.append("No stock volume found.")
            if volume_error:
                problems.append(volume_error)
            return steps, problems, None
        # the first plan call has no choice yet; a choice that vanished is an
        # error, never silently another volume
        vol = next((v for v in vols if v["key"] == req.get("volume")), None if req.get("volume") else vols[0])
        if not vol:
            problems.append("The selected volume no longer exists; please choose again.")
            return steps, problems, None
        req["volume"] = vol["key"]
        if not info["stick"]:
            problems.append("No UntrashOS stick found (needed for the disk metadata backup).")
        if "utslot" not in slot:
            problems.append("UNTRASH/system/slot.utslot (system image for ways B/C) is missing on the stick.")
        if vol["free"] < need_bytes(slot, vol):
            problems.append("Only %2 GB free on “%1”, %3 GB needed." % (
                vol["name"], vol["free"] / 1e9, need_bytes(slot, vol) / 1e9))
        if m == "B" and not info["stock_config"]:
            problems.append("Stock configuration missing on the stick (UNTRASH/*/etc-zyxel).")
        if vol["degraded"]:
            problems.append("The array of “%s” is incomplete (%d disk(s) found); insert all disks first "
                            "– the loader never writes to incomplete arrays." % (
                                vol["name"], len(vol["members"])))
        if any(d["kind"] == "untrash" for d in info["disks"]):
            problems.append("A disk carries UntrashOS partitions (way A); the loader starts these before "
                            "/.untrash. Remove this disk first.")
        if any(v["untrash"] for v in vols if v["key"] != vol["key"]):
            problems.append("Another volume already carries UntrashOS (/.untrash); the loader would take the first.")
        steps = ["Back up the partition tables and RAID/LVM metadata of the disks of “%s” to the stick" % vol["name"],
                 "Mount volume “%s” (%s, %s) writable; no partition and no array is changed" % (
                     vol["name"], vol["kind"], vol["level"]),
                 "Store system image %s twice as /.untrash/slot-a/b.utslot and read it back (%.1f GB)" % (
                     slot.get("version", "?"), 2 * slot.get("size", 0) / 1e9),
                 "Create the state (/.untrash/state.img, 4 GiB) and swap (/.untrash/swap.img, 1 GiB)"
                 + (" – the existing state is kept" if vol["untrash"] else ""),
                 "Write the boot counter /.untrash/bootstate, remove the marker UNTRASH/INSTALL from the stick"]
        if m == "B":
            steps.append("Stock configuration to /.untrash/stock-config; on the first start UntrashOS takes over "
                         "users, groups, shares and SMB passwords")
        else:
            shares = new_shares(vol)
            steps.append("New configuration: user admin with the password below (SMB, SSH), network name "
                         "as below, %d share(s) for admin (read/write): %s" % (
                             len(shares), ", ".join(n for n, _p in shares) or "none"))
            steps.append("The old stock users and rights are not taken over")
        steps.append("Confirm at the NAS: press the COPY button")
        phrase = "KEEP"
    else:
        problems.append("Unknown way.")
        phrase = None
    return steps, problems, phrase


def start(req):
    info = scan()
    steps, problems, phrase = plan(req, info)
    if req.get("mode") == "C":
        problems += new_config_problems(req)
    if problems:
        return 409, {"problems": problems}
    if req.get("phrase", "").strip() != phrase:
        return 403, {"problems": ["Confirmation text does not match (expected: %s)." % phrase]}
    with JOB.lock:
        if JOB.state in ("waiting-copy", "running"):
            return 409, {"problems": ["An operation is already running."]}
        JOB.state, JOB.mode, JOB.log = "waiting-copy", req["mode"], []
        JOB.copy_deadline = time.time() + COPY_WAIT

    def worker():
        mode = MODES[req["mode"]]
        JOB.add("Way %s: %s%s" % (req["mode"], mode["title"], " (DRY RUN)" if DRYRUN else ""))
        if mode.get("copy"):
            JOB.add("Waiting for the COPY button at the NAS (%d s) ..." % COPY_WAIT)
            if not wait_copy_key():
                JOB.add("No COPY button: cancelled, nothing changed.")
                JOB.state = "failed"
                return
            JOB.add("COPY button detected.")
        JOB.state = "running"
        try:
            mode["fn"](req, info)
            JOB.state = "done"
        except Exception as e:  # report, never retry automatically
            JOB.add("ERROR: %s" % e)
            JOB.state = "failed"
    threading.Thread(target=worker, daemon=True).start()
    return 202, {"ok": True}


