</main></div><script>
const $=s=>document.querySelector(s);let INFO=null;
UTI18N.ready.then(()=>{const l=$('#lang');l.value=UTI18N.lang;l.onchange=()=>UTI18N.set(l.value);});
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const gb=b=>(b/1e9).toFixed(b>1e11?0:1)+' GB';
const KIND={untrash:'UntrashOS',stock:'Zyxel-Stock',empty:'empty',raid:'RAID member',foreign:'unknown'};
const KPILL={untrash:'ok',stock:'info',empty:'',raid:'info',foreign:'warn'};
async function load(){INFO=await (await fetch('api/scan')).json();render()}
function render(){const i=INFO;let h='<div class=found-meta>';
 h+=i.stick?`<span class="ut-pill ut-pill--ok">Stick: ${esc(i.stick.model)} · ${gb(i.stick.size)}</span>`+(i.slot?`<span class="ut-pill ut-pill--ok">System image ${esc(i.slot.version)}</span>`:'<span class="ut-pill ut-pill--danger">System image missing</span>')+(i.backups.some(b=>b.stock&&b.verified)?'<span class="ut-pill ut-pill--ok">Stock backup present, checked</span>':(i.backups.some(b=>b.stock)?'<span class="ut-pill ut-pill--warn">Stock backup present (not checked)</span>':'<span class="ut-pill ut-pill--danger">No stock backup</span>')):'<span class="ut-pill ut-pill--danger">No UntrashOS stick found</span>';
 if(i.stock_config)h+='<span class="ut-pill ut-pill--info">Stock configuration on the stick</span>';
 h+='</div><div class=ut-table-wrap><table class=ut-table><thead><tr><th>Disk</th><th class=num>Size</th><th>Model</th><th>Contents</th></tr></thead><tbody>';
 for(const d of i.disks)h+=`<tr><td>${esc(d.name)}${d.system?' <span class=ut-faint>(currently running)</span>':''}</td><td class=num>${gb(d.size)}</td><td>${esc(d.model)}</td><td><span class="ut-pill ${KPILL[d.kind]?'ut-pill--'+KPILL[d.kind]:''}">${KIND[d.kind]||esc(d.kind)}</span></td></tr>`;
 h+='</tbody></table></div>';const vols=i.stock_arrays.filter(a=>a.role==='stock-data');
 if(vols.length)h+=`<p class=ut-muted style="margin:10px 0 0">Stock data arrays: ${vols.map(a=>esc(a.level)+' ('+a.members.length+' disk(s))').join(', ')}</p>`;
 $('#found').innerHTML=h;
 const W={B:['Keep and take over','Reinstall without erasing: take over the old settings, users and shares.'],
  C:['Keep, set up anew','Reinstall without erasing: data stays, new users and settings.'],
  A:['Erase the disk and reinstall','The selected disk will be erased completely.'],
  D:['Back to the stock firmware','Write back the state saved before the installation (stick and browser only).']};
 $('#ways').innerHTML=Object.entries(W).map(([k,t])=>`<label class="ut-choice${k==='A'?' ut-choice--danger':''}"><span class=ut-choice__key>${k}</span><input type=radio name=way value=${k} hidden><span><b>${t[0]}</b><small>${t[1]}</small></span></label>`).join('');
 document.querySelectorAll('input[name=way]').forEach(r=>r.onchange=()=>detail(r.value));}
async function detail(m,extra={}){const box=$('#detail');box.hidden=false;let sel='';
 if(m==='A')sel=`<div class=ut-field><label for=disk>Disk</label><select class=ut-select id=disk>${INFO.disks.map(d=>`<option value="${esc(d.name)}">${esc(d.name)} – ${gb(d.size)} ${esc(d.model)} (${KIND[d.kind]})</option>`).join('')}</select></div>`;
 if(m==='C')sel=`<div class=ut-field><label for=netname>Network name</label><input class=ut-input id=netname value="untrash" maxlength=15 autocomplete=off></div><div class=ut-field><label for=pw1>New password for admin (at least 8 characters)</label><input class=ut-input type=password id=pw1 autocomplete=new-password></div><div class=ut-field><label for=pw2>Repeat password</label><input class=ut-input type=password id=pw2 autocomplete=new-password></div>`;
 if(m==='D')sel=`<div class=ut-field><label for=backup>Backup</label><select class=ut-select id=backup>${INFO.backups.filter(b=>b.stock).reverse().map(b=>`<option>${esc(b.name)}</option>`).join('')}</select></div>`;
 box.innerHTML='<div class=ut-card__head><h3>Weg '+m+'</h3></div>'+sel+'<div id=planout class=ut-muted><span class=ut-spinner></span></div>';
 const upd=async()=>{const req={mode:m,disk:$('#disk')?.value,backup:$('#backup')?.value};
  if($('#volume'))req.volume=$('#volume').value;
  const p=await (await fetch('api/plan',{method:'POST',body:JSON.stringify(req)})).json();
  if(p.volumes&&p.volumes.length&&!$('#volume')){const v=document.createElement('div');v.className='ut-field';
   v.innerHTML='<label for=volume>Volume</label><select class=ut-select id=volume>'+p.volumes.map(x=>`<option value="${esc(x.key)}">${esc(x.name)} – ${gb(x.free)} free${x.sysvol?' (system volume)':''}${x.untrash?' · UntrashOS present':''}</option>`).join('')+'</select>';
   box.insertBefore(v,$('#planout'));}
  let h='<ol class=ut-steps>'+p.steps.map(s=>`<li>${esc(s)}</li>`).join('')+'</ol>';
  if(p.problems.length)h+=p.problems.map(x=>`<div class="ut-callout ut-callout--danger" style="margin-top:8px">${esc(x)}</div>`).join('');
  else if(p.phrase)h+=`<div class="ut-callout ${m==='A'?'ut-callout--danger':'ut-callout--warn'}" style="margin-top:8px"><div>Type to confirm: <b translate=no>${esc(p.phrase)}</b></div></div><div class=confirm><input class=ut-input type=text id=phrase autocomplete=off translate=no placeholder="${esc(p.phrase)}"><button class="ut-btn ${m==='A'?'ut-btn--danger':'ut-btn--primary'}" id=go>Start</button></div>`;
  if(m==='B'&&INFO.import_plan)h+=`<details><summary>Stock configuration</summary><pre class=ut-log>${esc(INFO.import_plan)}</pre></details>`;
  $('#planout').innerHTML=h;const go=$('#go');if(go)go.onclick=async()=>{req.phrase=$('#phrase').value;
   if(m==='C'){req.netname=$('#netname').value;req.password=$('#pw1').value;req.password2=$('#pw2').value;}
   req.lang=UTI18N.lang;
   const r=await fetch('api/start',{method:'POST',body:JSON.stringify(req)});const j=await r.json();if(!r.ok)alert((j.problems||[]).map(UTI18N.tr).join('\\n'));};};
 box.onchange=e=>{if(!e.target.matches('input[type=password],#netname,#phrase'))upd();};upd();}
async function reboot(){if(!confirm('Restart the NAS now?'))return;await fetch('api/reboot',{method:'POST',body:'{}'});
 $('#state').textContent='Restarting – the NAS now starts the installed system.';}
async function poll(){try{const j=await (await fetch('api/job')).json();
 $('#dry').innerHTML=j.dryrun?'<div class="ut-callout ut-callout--warn" style="margin-bottom:12px"><div><b>Dry run:</b> Commands are only shown, not run.</div></div>':'';
 const T={idle:'No operation.','waiting-copy':`Now press the COPY button at the NAS (still ${j.copy_left} s).`,running:'Running …',done:'Done.',failed:'Cancelled – see the log.'};
 const P={idle:['','ready'],'waiting-copy':['warn ut-pill--live','COPY button'],running:['info ut-pill--live','running'],done:['ok','done'],failed:['danger','Error']}[j.state]||['',j.state];
 $('#pill').className='ut-pill'+(P[0]?' ut-pill--'+P[0]:'');$('#pill').textContent=P[1];
 $('#state').textContent=(j.mode?'Weg '+j.mode+': ':'')+T[j.state];$('#log').hidden=!j.log.length;
 // log lines "HH:MM:SS text": messages are translated whole, commands ("$ ...", output) never
 $('#log').textContent=j.log.map(l=>{const m=/^(\\d\\d:\\d\\d:\\d\\d )(.*)$/s.exec(l);return m&&!/^(\\$ |  )/.test(m[2])?m[1]+UTI18N.tr(m[2]):l}).join('\\n');$('#after').hidden=j.state!=='done'||j.dryrun;}catch(e){}
 setTimeout(poll,1500);}
load();poll();
</script></body></html>"""

# design system (design, copied to /usr/share/untrash/design by mkslot-erofs.sh)
DESIGN = os.environ.get("ZT_DESIGN_DIR") or next(
    (d for d in ("/usr/share/untrash/design",
                 os.path.join(os.path.dirname(os.path.abspath(__file__)), "../../../../../design"))
     if os.path.isfile(os.path.join(d, "untrash.css"))), "/usr/share/untrash/design")
# user manual (docs/user-guide; in the image /usr/share/untrash/manual with index.html)
MANUAL = os.environ.get("ZT_MANUAL_DIR") or next(
    (d for d in ("/usr/share/untrash/manual",
                 os.path.join(os.path.dirname(os.path.abspath(__file__)), "../../../../../../docs/user-guide"))
     if os.path.isfile(os.path.join(d, "index.html")) or os.path.isfile(os.path.join(d, "manual.html"))),
    "/usr/share/untrash/manual")
STATIC_TYPES = {".css": "text/css", ".png": "image/png", ".svg": "image/svg+xml",
                ".jpg": "image/jpeg", ".ico": "image/x-icon", ".js": "text/javascript; charset=utf-8",
                ".json": "application/json; charset=utf-8", ".html": "text/html; charset=utf-8",
                ".webp": "image/webp", ".pdf": "application/pdf"}


def static_file(path, prefix="/ut/", root=None):
    """/ut/<rel> -> (bytes, type) inside DESIGN (or prefix/root), or None (no traversal)."""
    rel = path[len(prefix):].split("?", 1)[0]
    base = os.path.realpath(root or DESIGN)
    full = os.path.realpath(os.path.join(base, rel))
    ctype = STATIC_TYPES.get(os.path.splitext(full)[1])
    if not ctype or not full.startswith(base + os.sep) or not os.path.isfile(full):
        return None
    with open(full, "rb") as f:
        return f.read(), ctype


class Handler(BaseHTTPRequestHandler):
    def reply(self, code, obj, ctype="application/json"):
        if isinstance(obj, bytes):
            body = obj
        else:
            body = obj.encode() if isinstance(obj, str) else json.dumps(obj).encode()
            ctype += "; charset=utf-8"
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "max-age=3600" if isinstance(obj, bytes) else "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def body(self):
        n = int(self.headers.get("Content-Length") or 0)
        return json.loads(self.rfile.read(n) or b"{}") if n else {}

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            return self.reply(200, PAGE, "text/html")
        if self.path.startswith("/ut/"):
            f = static_file(self.path)
            return self.reply(200, *f) if f else self.reply(404, {"error": "not found"})
        if self.path in ("/manual", "/manual/"):
            f = static_file("/manual/index.html", "/manual/", MANUAL) or static_file("/manual/manual.html", "/manual/", MANUAL)
            return self.reply(200, *f) if f else self.reply(404, {"error": "not found"})
        if self.path.startswith("/manual/"):
            f = static_file(self.path, "/manual/", MANUAL)
            return self.reply(200, *f) if f else self.reply(404, {"error": "not found"})
        if self.path == "/api/scan":
            return self.reply(200, scan())
        if self.path == "/api/job":
            return self.reply(200, JOB.snapshot())
        self.reply(404, {"error": "not found"})

    def do_POST(self):
        req = self.body()
        if self.path == "/api/reboot":
            with JOB.lock:
                if JOB.state in ("waiting-copy", "running"):
                    return self.reply(409, {"problems": ["An operation is still running."]})
            if DRYRUN or TEST:
                return self.reply(409, {"problems": ["Dry run: no restart."]})
            threading.Timer(1.0, lambda: subprocess.run(["systemctl", "reboot"])).start()
            return self.reply(202, {"ok": True})
        if req.get("mode") not in MODES:
            return self.reply(400, {"problems": ["Unknown way."]})
        if self.path == "/api/plan":
            info = scan()
            steps, problems, phrase = plan(req, info)
            return self.reply(200, {"steps": steps, "problems": problems, "phrase": phrase,
                                    "volumes": info.get("volumes")})
        if self.path == "/api/start":
            code, obj = start(req)
            return self.reply(code, obj)
        self.reply(404, {"error": "not found"})

    def log_message(self, fmt, *args):
        pass


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "scan":
        print(json.dumps(scan(), indent=1))
        return
    print("untrash-installer on port %d%s" % (PORT, " (dry run)" if DRYRUN else ""), flush=True)
    ThreadingHTTPServer((os.environ.get("ZT_INSTALLER_BIND", ""), PORT), Handler).serve_forever()


if __name__ == "__main__":
    main()
