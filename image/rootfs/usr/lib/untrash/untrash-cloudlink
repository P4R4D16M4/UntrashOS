#!/usr/bin/python3
"""untrash-cloudlink - the NAS side of the Nextcloud companion.

  untrash-cloudlink run       the service (untrash-cloudlink.service)
  untrash-cloudlink status    JSON: linked clouds and the filesystems to watch

A Nextcloud with the untrash app is a cloud member of UntrashMesh
(untrash-mesh invite-cloud).  It reads the files over WebDAV with the users'
own rights; this service tells it what changed, so it never has to scan the
shares and the disks may sleep.  Contract: docs/architecture/cloud-api.md.

  GET /v1/info                       NAS, version, the shares this cloud follows
  GET /v1/changes?since=C&wait=S     changed paths since cursor C (long poll)
  GET /v1/health                     disks (asleep or temperature), RAID, space

Requests are signed with the cloud member's node key (Authorization:
UntrashCloud ...); only members of kind "cloud" linked on this NAS
(clouds.json, untrash-mesh cloud-link) get answers, and only about their
shares.  The service listens on 127.0.0.1; Apache (the WebDAV server, ports
5002/5003) passes /untrash-cloudlink/ on, so it has the WebDAV TLS.

Change feed: fanotify, one group per filesystem with a filesystem mark and
FAN_REPORT_DFID_NAME.  It needs no watch per directory (no RAM per folder,
no limit on the number of folders) and answers from a RAM ring, so the
disks are never touched for it.  When the kernel queue overflows, a name
cannot be resolved or the service restarts, the affected shares are
reported for a rescan instead (the cursor names the service run).

Test hooks: ZT_CLOUDLINK_ROOT (prefix for the stock database and share
paths), ZT_MESH_DIR, ZT_SIG, ZT_CLOUDLINK_PORT, ZT_CLOUDLINK_FAKE_FEED (a
file the test appends lines to: an absolute path, or "!overflow PATH"),
ZT_CLOUDLINK_FAKE_HEALTH (JSON file instead of the live values).
"""
import collections
import ctypes
import hashlib
import json
import os
import re
import secrets
import select
import sqlite3
import struct
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

E = os.environ.get
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HERE, "pylib"))

R = E("ZT_CLOUDLINK_ROOT", "")
MESH_DIR = E("ZT_MESH_DIR", R + "/etc/untrash/mesh")
DB = R + "/etc/untrash/zyxel/stock-config/ugs_conf.db"
ZT_SIG = E("ZT_SIG", "/usr/lib/untrash/zt-sig")
PORT = int(E("ZT_CLOUDLINK_PORT", "7342"))
FAKE_FEED = E("ZT_CLOUDLINK_FAKE_FEED")
FAKE_HEALTH = E("ZT_CLOUDLINK_FAKE_HEALTH")
API = 1
RING_MAX = 20000            # changes kept in RAM (~2-4 MB at most)
ANSWER_MAX = 5000           # changes per answer; more: "more": true
WAIT_MAX = 120              # long poll; Apache's Timeout is 300 s
EPOCH = secrets.token_hex(4)  # a new run: every old cursor means "rescan"
LOCK = threading.Condition()
RING = collections.deque()  # (seq, absolute path)
RESCAN = {}                 # absolute directory (a filesystem's share root) -> seq of the rescan
SEQ = [0]
DROPPED = [0]               # highest seq that fell out of the ring
NONCES = {}
WATCHED = {}                # st_dev -> {"path", "fd", "mount_fd"}


def log(msg):
    print("untrash-cloudlink: " + msg, flush=True)


def jload(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


# ------------------------------------------------------------ mesh, clouds, shares

def mesh_state():
    return jload(os.path.join(MESH_DIR, "mesh.json"), {})


def clouds():
    """{node: {"pub", "name", "shares"}} of the cloud members linked here."""
    st, links = mesh_state(), jload(os.path.join(MESH_DIR, "clouds.json"), {})
    out = {}
    for k, m in ((st.get("roster") or {}).get("members") or {}).items():
        if m.get("kind") == "cloud" and k in links and st.get("mesh"):
            out[k] = {"pub": m["pub"], "name": m.get("name", ""), "shares": list(links[k].get("shares") or [])}
    return out


_SHARES = {"t": 0, "v": {}}


def shares():
    """{share name: absolute path} of the enabled shares (stock database)."""
    if time.time() - _SHARES["t"] < 30:
        return _SHARES["v"]
    v = {}
    if os.path.isfile(DB):
        c = sqlite3.connect("file:%s?mode=ro" % DB, uri=True)
        try:
            for name, path in c.execute("SELECT s_name, s_path FROM smb_share WHERE s_enable='y'"):
                v[name] = os.path.normpath(R + path)
        finally:
            c.close()
    _SHARES.update(t=time.time(), v=v)
    return v


def share_of(path, names):
    """(share, path relative to it) for an absolute path, among names."""
    sh = shares()
    best = None
    for n in names:
        root = sh.get(n)
        if root and (path == root or path.startswith(root.rstrip("/") + "/")):
            if not best or len(root) > len(sh[best]):
                best = n
    if not best:
        return None
    return best, os.path.relpath(path, sh[best]).replace(os.sep, "/") if path != sh[best] else ""


def hidden(rel):
    """Not for Nextcloud: the recycle bin and stock/system folders."""
    first = rel.split("/", 1)[0]
    return first.startswith((".untrash", "@", ".@__thumb")) or first in (".recycle", "lost+found")


# ------------------------------------------------------------ the feed

def add(path):
    with LOCK:
        SEQ[0] += 1
        RING.append((SEQ[0], path))
        while len(RING) > RING_MAX:
            DROPPED[0] = RING.popleft()[0]
        LOCK.notify_all()


def add_rescan(root):
    with LOCK:
        SEQ[0] += 1
        RESCAN[root] = SEQ[0]
        LOCK.notify_all()


FAN_CLOEXEC, FAN_NONBLOCK, FAN_CLASS_NOTIF = 0x1, 0x2, 0x0
FAN_REPORT_DIR_FID, FAN_REPORT_NAME = 0x400, 0x800
FAN_MARK_ADD, FAN_MARK_FILESYSTEM = 0x1, 0x100
FAN_CLOSE_WRITE, FAN_MOVED_FROM, FAN_MOVED_TO = 0x8, 0x40, 0x80
FAN_CREATE, FAN_DELETE, FAN_Q_OVERFLOW, FAN_ONDIR = 0x100, 0x200, 0x4000, 0x40000000
FAN_EVENT_INFO_TYPE_DFID_NAME = 2
MASK = FAN_CLOSE_WRITE | FAN_MOVED_FROM | FAN_MOVED_TO | FAN_CREATE | FAN_DELETE | FAN_ONDIR
META = struct.Struct("=IBBHQii")         # struct fanotify_event_metadata (24 bytes)

_libc = ctypes.CDLL(None, use_errno=True)
_libc.fanotify_init.argtypes = [ctypes.c_uint, ctypes.c_uint]
_libc.fanotify_mark.argtypes = [ctypes.c_int, ctypes.c_uint, ctypes.c_uint64, ctypes.c_int, ctypes.c_char_p]
_libc.open_by_handle_at.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int]


def watch_wanted():
    """One share path per filesystem that a linked cloud follows."""
    want = {}
    sh = shares()
    for c in clouds().values():
        for n in c["shares"]:
            p = sh.get(n)
            try:
                dev = os.stat(p).st_dev if p else None
            except OSError:
                dev = None
            if dev is not None and dev not in want:
                want[dev] = p
    return want


def watch_update():
    """Mark the filesystems of the linked shares; drop the others."""
    want = watch_wanted()
    for dev in [d for d in WATCHED if d not in want]:
        w = WATCHED.pop(dev)
        os.close(w["fd"])
        os.close(w["mount_fd"])
        log("stopped watching %s" % w["path"])
    for dev, p in want.items():
        if dev in WATCHED:
            continue
        fd = _libc.fanotify_init(FAN_CLASS_NOTIF | FAN_CLOEXEC | FAN_NONBLOCK | FAN_REPORT_DIR_FID | FAN_REPORT_NAME,
                                 os.O_RDONLY)
        if fd < 0:
            log("fanotify_init: %s" % os.strerror(ctypes.get_errno()))
            return
        if _libc.fanotify_mark(fd, FAN_MARK_ADD | FAN_MARK_FILESYSTEM, MASK, -100, p.encode()) < 0:
            log("fanotify_mark %s: %s" % (p, os.strerror(ctypes.get_errno())))
            os.close(fd)
            continue
        WATCHED[dev] = {"path": p, "fd": fd, "mount_fd": os.open(p, os.O_RDONLY | os.O_DIRECTORY)}
        log("watching the filesystem of %s" % p)
        # what changed before the mark is unknown: the shares on it are rescanned
        rescan_dev(dev)


def rescan_dev(dev):
    for n, p in shares().items():
        try:
            if os.stat(p).st_dev == dev:
                add_rescan(p)
        except OSError:
            pass


def read_events(dev, w):
    try:
        buf = os.read(w["fd"], 65536)
    except BlockingIOError:
        return
    off = 0
    while off + META.size <= len(buf):
        ln, _vers, _res, mlen, mask, _fd, _pid = META.unpack_from(buf, off)
        if ln < META.size:
            break
        if mask & FAN_Q_OVERFLOW:
            log("event queue overflow on %s: rescan" % w["path"])
            rescan_dev(dev)
        else:
            i = off + mlen
            while i + 4 <= off + ln:
                itype, _pad, ilen = struct.unpack_from("=BBH", buf, i)
                if ilen < 4:
                    break
                if itype == FAN_EVENT_INFO_TYPE_DFID_NAME:
                    h = i + 4 + 8                               # header, fsid
                    hbytes = struct.unpack_from("=I", buf, h)[0]
                    handle = bytes(buf[h:h + 8 + hbytes])       # struct file_handle
                    name = bytes(buf[h + 8 + hbytes:i + ilen]).split(b"\0", 1)[0].decode("utf-8", "surrogateescape")
                    path = resolve(w["mount_fd"], handle)
                    if path is None:
                        rescan_dev(dev)                         # e.g. the folder is gone already
                    elif name and name != ".":
                        add(os.path.join(path, name))
                    else:
                        add(path)
                i += ilen
        off += ln


def resolve(mount_fd, handle):
    fd = _libc.open_by_handle_at(mount_fd, handle, os.O_PATH)
    if fd < 0:
        return None
    try:
        return os.readlink("/proc/self/fd/%d" % fd)
    except OSError:
        return None
    finally:
        os.close(fd)


def feed_fanotify():
    last = 0
    while True:
        if time.time() - last > 60:          # links, shares or mounts changed
            try:
                watch_update()
            except OSError as e:
                log("watch: %s" % e)
            last = time.time()
        fds = {w["fd"]: (d, w) for d, w in WATCHED.items()}
        r = select.select(list(fds), [], [], 5)[0] if fds else (time.sleep(5) or [])
        for fd in r:
            read_events(*fds[fd])


def feed_fake():
    """PC test: lines appended to a file stand in for the kernel's events."""
    pos = 0
    while True:
        try:
            with open(FAKE_FEED) as f:
                f.seek(pos)
                for line in f:
                    line = line.rstrip("\n")
                    if line.startswith("!overflow "):
                        add_rescan(line[10:])
                    elif line:
                        add(line)
                pos = f.tell()
        except OSError:
            pass
        time.sleep(0.1)


# ------------------------------------------------------------ answers

def cursor():
    return "%s-%d" % (EPOCH, SEQ[0])


def changes(names, since, wait):
    """Changes under the shares names since the cursor `since`."""
    sh = shares()
    m = re.fullmatch(r"([0-9a-f]{8})-(\d+)", since or "")
    if not m or m.group(1) != EPOCH:
        return {"cursor": cursor(), "changes": [], "rescan": sorted(n for n in names if n in sh)}
    n0 = int(m.group(2))
    end = time.time() + max(0, min(wait, WAIT_MAX))
    with LOCK:
        while True:
            if DROPPED[0] > n0:
                # the ring dropped changes this cloud has not seen yet
                return {"cursor": cursor(), "changes": [], "rescan": sorted(n for n in names if n in sh)}
            out, seen, rescan, last = [], set(), set(), n0
            for root, s in RESCAN.items():
                if s > n0:
                    for n in names:
                        if sh.get(n) and (sh[n] == root or sh[n].startswith(root.rstrip("/") + "/")
                                          or root.startswith(sh[n].rstrip("/") + "/")):
                            rescan.add(n)
            more = False
            for s, p in RING:
                if s <= n0:
                    continue
                hit = share_of(p, names)
                if hit and not hidden(hit[1]) and hit not in seen:
                    if len(out) >= ANSWER_MAX:
                        more = True
                        break
                    seen.add(hit)
                    out.append({"share": hit[0], "path": hit[1]})
                last = s
            if out or rescan or more or time.time() >= end:
                cur = "%s-%d" % (EPOCH, last if more else SEQ[0])
                return dict({"cursor": cur, "changes": out, "rescan": sorted(rescan)}, **({"more": True} if more else {}))
            LOCK.wait(max(0.05, end - time.time()))
            n0 = last


def mdstat():
    out = []
    try:
        text = open(R + "/proc/mdstat").read()
    except OSError:
        return out
    for m in re.finditer(r"^(md\d+) : (\S+) (\S+)?.*?\n.*?\[(\d+)/(\d+)\] \[([U_]+)\](.*?)(?=^md\d+ :|\Z)", text, re.M | re.S):
        act = re.search(r"(resync|recovery|check|reshape)\s*=\s*([\d.]+)%", m.group(7))
        out.append({"name": m.group(1), "state": m.group(2), "disks": int(m.group(4)), "up": int(m.group(5)),
                    "map": m.group(6), "activity": act.group(1) if act else None,
                    "progress": float(act.group(2)) if act else None})
    return out


def health(names):
    if FAKE_HEALTH:
        h = jload(FAKE_HEALTH, {})
    else:
        import untrash_live
        lv = untrash_live.live()
        h = {"disks": [{"name": d, "asleep": t is None, "temp": t} for d, t in sorted(lv["disks"].items())],
             "raid": mdstat(), "load": lv["load"], "mem": lv["mem"], "uptime": lv["uptime"]}
    vols, sh = {}, shares()
    for n in names:
        p = sh.get(n)
        try:
            s = os.statvfs(p) if p else None             # the superblock in RAM: wakes no disk
        except OSError:
            s = None
        if s:
            vols.setdefault(os.stat(p).st_dev, {"shares": [], "size": s.f_blocks * s.f_frsize,
                                                "free": s.f_bavail * s.f_frsize})["shares"].append(n)
    h["volumes"] = list(vols.values())
    h["time"] = int(time.time())
    return h


def first(path, default=""):
    try:
        return open(path).read().strip()
    except OSError:
        return default


# ------------------------------------------------------------ HTTP

def sig_ok(pub, msg, sig):
    with tempfile.TemporaryDirectory() as d:
        for n, b in (("k", bytes.fromhex(pub)), ("m", msg), ("s", bytes.fromhex(sig))):
            open(os.path.join(d, n), "wb").write(b)
        return subprocess.run([ZT_SIG, "verify", d + "/k", d + "/m", d + "/s"], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL).returncode == 0


class Refused(Exception):
    pass


def auth(handler, method, raw):
    """The linked cloud that signed this request (cloud-api.md, "Signed
    requests"); anything else is refused."""
    h = handler.headers.get("Authorization") or ""
    if not h.startswith("UntrashCloud "):
        raise Refused("unsigned request")
    f = dict(x.strip().split("=", 1) for x in h[13:].split(",") if "=" in x)
    node, ts, nonce, sig = f.get("node", ""), f.get("ts", ""), f.get("nonce", ""), f.get("sig", "")
    if not (re.fullmatch(r"[0-9a-f]{16}", node) and re.fullmatch(r"\d{9,11}", ts) and re.fullmatch(r"[0-9a-f]{16,64}", nonce)
            and re.fullmatch(r"[0-9a-f]{128}", sig)):
        raise Refused("malformed signature")
    now = time.time()
    if abs(now - int(ts)) > 120:
        raise Refused("request too old (check the clocks)")
    c = clouds().get(node)
    if not c:
        raise Refused("not a cloud linked to this NAS")
    msg = "\n".join(["UTCL1", method, handler.path, ts, nonce, hashlib.sha256(raw).hexdigest()]).encode()
    if not sig_ok(c["pub"], msg, sig):
        raise Refused("wrong signature")
    with LOCK:                         # after the signature: a forged request burns no nonce
        for k in [k for k, t in NONCES.items() if t < now]:
            del NONCES[k]
        if nonce in NONCES:
            raise Refused("request replayed")
        NONCES[nonce] = now + 300
    return node, c


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def send(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        try:
            node, c = auth(self, "GET", b"")
        except Refused as e:
            return self.send(401, {"error": str(e)})
        u = urllib.parse.urlsplit(self.path)
        q = dict(urllib.parse.parse_qsl(u.query))
        names = [n for n in c["shares"] if n in shares()]
        if u.path == "/v1/info":
            st = mesh_state()
            return self.send(200, {"api": API, "nas": st.get("name"), "mesh": (st.get("mesh") or {}).get("name"),
                                   "node": nas_node(), "version": first(R + "/etc/untrash-version", "?"),
                                   "you": node, "shares": [{"name": n, "webdav": "/webdav/" + urllib.parse.quote(n),
                                                            "feed": feed_on(n)} for n in names],
                                   "cursor": cursor()})
        if u.path == "/v1/changes":
            try:
                wait = float(q.get("wait", "0"))
            except ValueError:
                wait = 0
            return self.send(200, changes(names, q.get("since", ""), wait))
        if u.path == "/v1/health":
            return self.send(200, health(names))
        return self.send(404, {"error": "unknown"})


def feed_on(name):
    """False for a share whose filesystem has no feed (a CIFS partner volume,
    or not marked yet): the cloud has to check it for changes itself."""
    if FAKE_FEED:
        return True
    try:
        return os.stat(shares()[name]).st_dev in WATCHED
    except (OSError, KeyError):
        return False


def nas_node():
    try:
        return hashlib.sha256(open(os.path.join(MESH_DIR, "node.pub"), "rb").read()).hexdigest()[:16]
    except OSError:
        return None


def status():
    """What the service would watch (the feed itself lives in the service)."""
    return {"clouds": {k: {"name": v["name"], "shares": v["shares"]} for k, v in clouds().items()},
            "filesystems": sorted(watch_wanted().values())}


def cmd_run():
    threading.Thread(target=feed_fake if FAKE_FEED else feed_fanotify, daemon=True).start()
    srv = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    srv.daemon_threads = True
    log("running on 127.0.0.1:%d" % PORT)
    srv.serve_forever()


def main():
    a = sys.argv[1:]
    if a == ["run"]:
        return cmd_run()
    if a == ["status"]:
        print(json.dumps(status()))
        return 0
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
