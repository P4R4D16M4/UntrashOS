    def webpublish(self, p):
        """Stock Web Publishing on port 80: http://NAS/MyWeb/<share>/... for
        shares with web_public=y, public and read-only (index.html if
        present, otherwise a file list)."""
        # published pages are user content on the Desk's origin: a CSP sandbox
        # gives them an opaque origin (no Desk cookies, no API calls)
        sb = [("Content-Security-Policy", "sandbox allow-scripts allow-forms allow-popups allow-downloads")]
        wp = settings_load()["services"]["webpublish"]
        parts = urllib.parse.unquote(p).split("/")[2:]
        pub = {}
        if wp["active"] and int(wp["port"]) == 80:
            c = db()
            try:
                pub = {n.lower(): (n, path) for n, path in c.execute(
                    "SELECT s_name, s_path FROM smb_share WHERE s_enable='y' AND web_public='y'")}
            finally:
                c.close()
        if not pub:
            return self.reply(404, "Web publishing is off.", "text/plain; charset=utf-8", sb)
        if not parts or not parts[0]:
            body = "".join('<li><a href="/MyWeb/%s/">%s</a></li>' % (urllib.parse.quote(n), html.escape(n))
                           for n, _p in sorted(pub.values()))
            return self.reply(200, "<!doctype html><meta charset=utf-8><title>MyWeb</title><ul>%s</ul>" % body,
                              "text/html; charset=utf-8", sb)
        share = pub.get(parts[0].lower())
        if not share:
            return self.reply(404, "Not found.", "text/plain; charset=utf-8", sb)
        base = os.path.realpath(R + share[1])
        full = os.path.realpath(os.path.join(base, *[x for x in parts[1:] if x]))
        if full != base and not full.startswith(base + "/"):
            return self.reply(403, "Forbidden.", "text/plain; charset=utf-8", sb)
        if os.path.isdir(full):
            if not p.endswith("/"):
                self.send_response(301)
                self.send_header("Location", urllib.parse.quote(urllib.parse.unquote(p)) + "/")
                self.send_header("Content-Length", "0")
                self.send_header(*sb[0])
                self.end_headers()
                return
            if os.path.isfile(os.path.join(full, "index.html")):
                full = os.path.join(full, "index.html")
            else:
                ents = sorted(e for e in os.listdir(full) if not e.startswith("."))
                body = "".join('<li><a href="%s%s">%s%s</a></li>' % (
                    urllib.parse.quote(e), "/" if os.path.isdir(os.path.join(full, e)) else "", html.escape(e),
                    "/" if os.path.isdir(os.path.join(full, e)) else "") for e in ents)
                return self.reply(200, "<!doctype html><meta charset=utf-8><title>%s</title><h1>%s</h1><ul>%s</ul>" % (
                    html.escape(share[0]), html.escape(urllib.parse.unquote(p)), body), "text/html; charset=utf-8", sb)
        if not os.path.isfile(full):
            return self.reply(404, "Not found.", "text/plain; charset=utf-8", sb)
        ctype = mimetypes.guess_type(full)[0] or "application/octet-stream"
        size = os.path.getsize(full)
        self.send_response(200)
        self.send_header("Content-Type", ctype + ("; charset=utf-8" if ctype.startswith("text/") else ""))
        self.send_header("Content-Length", str(size))
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header(*sb[0])
        self.end_headers()
        if self.command != "HEAD":
            with open(full, "rb") as f:
                shutil.copyfileobj(f, self.wfile, 1 << 20)

    def tv(self, rel):
        """Broadcast channels: /tv/channels.m3u, /tv/<id>/index.m3u8, /tv/<id>/segNNNNNN.ts.
        Open in the home network without login when "lan_open" (TVs, VLC and
        Kodi cannot log in); otherwise only for signed-in users."""
        ip = self.client_address[0]
        if not (session_user(self) or (TV.load()["lan_open"] and lan_client(ip))):
            raise Fail("Please sign in.", 401)
        if rel == "channels.m3u":
            host = self.headers.get("Host") or "untrash.local"
            proto = "https" if getattr(self.server, "tls", False) else "http"
            lines = ["#EXTM3U"] + sum((["#EXTINF:-1 tvg-id=\"%s\" group-title=\"UntrashOS\"%s,%s" % (
                c["id"], " radio=\"true\"" if c.get("profile") == "radio" else "", c["name"]),
                "%s://%s/tv/%s/index.m3u8" % (proto, host, c["id"])] for c in TV.load()["channels"]), [])
            return self.reply(200, "\n".join(lines) + "\n", "audio/x-mpegurl; charset=utf-8",
                              headers=[("Content-Disposition", 'inline; filename="untrash-sender.m3u"')])
        m = re.fullmatch(r"([0-9a-f]{6})/(index\.m3u8|seg\d{6}\.ts)", rel)
        if not m:
            return self.reply(404, {"error": "not found"})
        cid, f = m.groups()
        if f == "index.m3u8":
            d = tv_call(TV.wait_ready, cid)
        else:
            r = TV.run.get(cid)
            if not r:
                return self.reply(404, {"error": "not found"})
            d = r["dir"]
        TV.touch(cid, ip)
        try:
            data = open(os.path.join(d, f), "rb").read()
        except OSError:
            return self.reply(404, {"error": "not found"})
        if f.endswith(".m3u8"):
            return self.reply(200, data, "application/vnd.apple.mpegurl", headers=[("Cache-Control", "no-cache")])
        return self.reply(200, data, "video/mp2t", headers=[("Cache-Control", "max-age=20")])

    def share_link(self, tok, method):
        """Public download of a share link: the file, or a folder as a ZIP
        (stored, streamed).  A password link asks for it first (POST form)."""
        v = links_load().get(tok.split("/")[0])
        if not v:
            return self.reply(404, LINK_PAGE % ("Link", "UntrashOS", "<p>This link has expired or was deleted.</p>"),
                              "text/html; charset=utf-8")
        if v.get("pw"):
            pw = ""
            if method == "POST":
                n = min(int(self.headers.get("Content-Length") or 0), 4096)
                pw = urllib.parse.parse_qs(self.rfile.read(n).decode("utf-8", "replace")).get("pw", [""])[0]
            if not hmac.compare_digest(hashlib.sha256((v["salt"] + pw).encode()).hexdigest(), v["pw"]):
                form = ('<p>This link is protected with a password.</p>%s<div class="ut-field"><label for="pw">Password</label>'
                        '<input class="ut-input" id="pw" name="pw" type="password" autofocus></div>'
                        '<button class="ut-btn ut-btn--primary ut-btn--lg" style="width:100%%">Download</button>') % (
                            '<div class="ut-callout ut-callout--danger">Wrong password.</div>' if method == "POST" else "")
                return self.reply(200 if method == "GET" else 403, LINK_PAGE % ("Link", html.escape(os.path.basename(v["path"]) or v["share"]), form),
                                  "text/html; charset=utf-8")
        try:
            _b, full = resolve(v["owner"], v["share"], v["path"])     # the owner's rights still apply
        except Fail:
            return self.reply(410, LINK_PAGE % ("Link", "UntrashOS", "<p>No access to this file any more.</p>"), "text/html; charset=utf-8")
        if os.path.isfile(full):
            return self.send_file(full)
        if not os.path.isdir(full):
            return self.reply(404, LINK_PAGE % ("Link", "UntrashOS", "<p>The file no longer exists.</p>"), "text/html; charset=utf-8")
        return self.zip_stream([full], os.path.basename(full.rstrip("/")) or "download")

    def zip_stream(self, items, name):
        """Files and folders as one ZIP (stored, streamed while it is made;
        hidden files, links and recycle bins left out)."""
        import zipfile
        self.send_response(200)
        self.send_header("Content-Type", "application/zip")
        self.send_header("Content-Disposition", "attachment; filename*=UTF-8''%s.zip" % urllib.parse.quote(name))
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.close_connection = True

        class Out:            # unseekable sink: zipfile writes data descriptors
            def __init__(s, w):
                s.w, s.n = w, 0

            def write(s, b):
                s.w.write(b)
                s.n += len(b)
                return len(b)

            def tell(s):
                return s.n

            def flush(s):
                s.w.flush()
        try:
            with zipfile.ZipFile(Out(self.wfile), "w", zipfile.ZIP_STORED, allowZip64=True) as z:
                for full in items:
                    if os.path.islink(full):
                        continue
                    top = os.path.basename(full.rstrip("/")) or name
                    if os.path.isfile(full):
                        z.write(full, top)
                        continue
                    for d, dirs, files in os.walk(full):
                        dirs[:] = [x for x in dirs if not x.startswith(".") and x not in (IMP.RECYCLE_FN,)]
                        rel = os.path.relpath(d, full)
                        if not files and not dirs:
                            z.writestr(os.path.join(top, rel if rel != "." else "", "").replace("/./", "/"), b"")   # empty folder
                        for f in files:
                            fp = os.path.join(d, f)
                            if os.path.islink(fp) or f.startswith("."):
                                continue
                            z.write(fp, os.path.join(top, os.path.relpath(fp, full)))
        except (BrokenPipeError, ConnectionResetError):
            pass

    def stream_media(self, full, q):
        """Remux for the player: video copied, sound to AAC unless the browser
        plays it, fragmented MP4 piped as it is produced.  t = start second
        (seeking restarts the stream), a = audio stream index (ffprobe)."""
        t = max(0.0, float(q.get("t") or 0))
        a = q.get("a", "")
        amap = ["-map", "0:%d" % int(a)] if a.isdigit() else ["-map", "0:a:0?"]
        cmd = [FFMPEG, "-nostdin", "-v", "error", "-ss", "%.3f" % t, "-i", full, "-map", "0:v:0?"] + amap + [
            "-sn", "-dn", "-c:v", "copy", "-c:a", "aac", "-b:a", "192k", "-ac", "2",
            "-movflags", "frag_keyframe+empty_moov+default_base_moof", "-f", "mp4", "pipe:1"]
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        self.send_response(200)
        self.send_header("Content-Type", "video/mp4")
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.close_connection = True
        try:
            while True:
                b = p.stdout.read(1 << 16)
                if not b:
                    break
                self.wfile.write(b)
        except (BrokenPipeError, ConnectionResetError):
            pass
        finally:
            p.kill()
            p.wait()

    def send_file(self, full, inline=False):
        """Download; inline (photo/music/video viewer) only for media types a
        browser cannot run as a page, with Range for seeking in audio/video."""
        size = os.path.getsize(full)
        ctype = mimetypes.guess_type(full)[0] or "application/octet-stream"
        inline = inline and (ctype in INLINE_TYPES or ctype.startswith(("audio/", "video/")))
        start, end = 0, size - 1
        rng = re.fullmatch(r"bytes=(\d*)-(\d*)", self.headers.get("Range") or "") if inline else None
        if rng and (rng.group(1) or rng.group(2)):
            if rng.group(1):
                start = int(rng.group(1))
                end = min(int(rng.group(2)), size - 1) if rng.group(2) else size - 1
            else:
                start = max(0, size - int(rng.group(2)))
            if start > end:
                self.send_response(416)
                self.send_header("Content-Range", "bytes */%d" % size)
                self.send_header("Content-Length", "0")
                self.end_headers()
                return
        self.send_response(206 if rng and (rng.group(1) or rng.group(2)) else 200)
        self.send_header("Content-Type", ctype if inline else "application/octet-stream")
        self.send_header("Content-Length", str(end - start + 1))
        self.send_header("Content-Disposition", "%s; filename*=UTF-8''%s" % ("inline" if inline else "attachment",
                                                                           urllib.parse.quote(os.path.basename(full))))
        self.send_header("X-Content-Type-Options", "nosniff")
        if inline:
            self.send_header("Accept-Ranges", "bytes")
            self.send_header("Content-Security-Policy", "sandbox; default-src 'none'; img-src 'self'; media-src 'self'")
            if start or end != size - 1:
                self.send_header("Content-Range", "bytes %d-%d/%d" % (start, end, size))
        self.end_headers()
        if self.command == "HEAD":
            return
        with open(full, "rb") as f:
            f.seek(start)
            left = end - start + 1
            while left > 0:
                b = f.read(min(left, 1 << 20))
                if not b:
                    break
                self.wfile.write(b)
                left -= len(b)

    def run(self, method):
        try:
            self.handle_any(method)
        except Fail as e:
            self.reply(e.code, dict(e.extra, error=str(e)))
        except (OSError, sqlite3.Error, ValueError, KeyError) as e:
            self.reply(500, {"error": "%s: %s" % (type(e).__name__, e)})
        except Exception as e:  # noqa: BLE001 - any bug: answer and log, never drop the connection
            # (an unanswered request shows up as "NetworkError" in the browser)
            import traceback
            sys.stderr.write("untrash-desk: %s %s failed:\n%s" % (method, self.path.split("?")[0], traceback.format_exc()))
            sys.stderr.flush()
            try:
                self.reply(500, {"error": "Internal error (%s: %s), details in the system log" % (type(e).__name__, e)})
            except OSError:
                pass

    def do_GET(self):
        self.run("GET")

    def do_HEAD(self):
        self.run("GET")

    def do_POST(self):
        self.run("POST")

    def log_message(self, fmt, *args):
        pass


HTTPS_STATE = {}
INLINE_TYPES = {"image/jpeg", "image/png", "image/gif", "image/webp", "image/bmp", "application/pdf"}


def main():
    import ssl
    bind = os.environ.get("ZT_DESK_BIND", "")
    hs = settings_load()["services"]["https"]
    crt, key = TLS_DIR + "/untrash.crt", TLS_DIR + "/untrash.key"
    if hs.get("active") and os.path.isfile(crt) and os.path.isfile(key):
        port = int(os.environ.get("ZT_DESK_TLS_PORT") or hs["port"])
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.minimum_version = ssl.TLSVersion.TLSv1_2
        ctx.load_cert_chain(crt, key)
        srv = ThreadingHTTPServer((bind, port), Handler)
        srv.socket = ctx.wrap_socket(srv.socket, server_side=True)
        srv.tls = True
        HTTPS_STATE.update(port=port, force=bool(hs.get("force")))
        threading.Thread(target=srv.serve_forever, daemon=True).start()
        print("untrash-desk https on port %d%s" % (port, ", http redirects" if hs.get("force") else ""), flush=True)
    print("untrash-desk on port %d%s" % (PORT, " (TEST)" if TEST else ""), flush=True)
    ThreadingHTTPServer((bind, PORT), Handler).serve_forever()


if __name__ == "__main__":
    main()
