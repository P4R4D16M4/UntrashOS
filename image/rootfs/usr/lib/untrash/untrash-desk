def setup(req):
    """Way A (or any system without users): admin password + name."""
    if initialized():
        raise Fail("Already set up.", 409)
    check_password(req.get("password", ""))
    name = (req.get("name") or "untrash").strip()
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]{0,14}", name):
        raise Fail("Name: up to 15 characters, letters, digits, hyphen.")
    c = db()
    try:
        c.executemany("INSERT INTO smb_user VALUES (?,?,?,?,?,?)",
                      [(501, "admin", "bulit-in", "admin", "", ""), (502, GUEST, "bulit-in", "guest", "", "")])
        c.execute("INSERT OR IGNORE INTO smb_group VALUES (500, ?, 'local', 'System default group')", (EVERYONE,))
        c.commit()
    finally:
        c.close()
    for cmd in (["groupadd", "-g", "500", EVERYONE], ["useradd", "-u", "501", "-g", "500", "-M", "-d", "/nonexistent",
                                                       "-s", "/bin/bash", "admin"],
                ["useradd", "-u", "502", "-g", "500", "-M", "-d", "/nonexistent", "-s", "/usr/sbin/nologin", GUEST]):
        sysrun(cmd, check=False)
    smb_set_password("admin", 501, req["password"])
    s = settings_load()
    s["hostname"] = name.lower()
    s["netbios"]["name"] = name.upper()[:15]
    settings_save(s)
    mark_takeover()
    vols = [v for v in volumes() if v["kind"] == "intern"]
    if vols:
        for share in ("public",):
            try:
                share_save({"new": True, "name": share, "volume": vols[0]["id"], "users": {"admin": "rw"},
                            "groups": {EVERYONE: "rw"}})
            except Fail:
                pass
    resmb()
    return {}


RESET_MARK = R + "/run/untrash/admin-reset"


def reset_window():
    """Seconds left to set the admin password without login after the RESET
    button (physical access proves the right, untrash-config reset-network)."""
    try:
        left = 900 - (time.time() - os.path.getmtime(RESET_MARK))
    except OSError:
        return 0
    return int(left) if left > 0 and initialized() else 0


def reset_admin(req):
    if not reset_window():
        raise Fail("No reset active (hold the RESET button for 2 seconds).", 403)
    check_password(req.get("password", ""))
    c = db()
    try:
        r = c.execute("SELECT uid FROM smb_user WHERE uname='admin'").fetchone()
    finally:
        c.close()
    smb_set_password("admin", r[0], req["password"])
    if not TEST:
        sysrun(["usermod", "-U", "admin"], check=False)
    os.unlink(RESET_MARK)
    signin_set("admin", "password")        # physical access also ends a lost phone's second factor
    FAILS.clear()
    return {}


# ---------------------------------------------------------------- sessions

SESSIONS = {}          # token -> (user, expiry)
FAILS = {}             # address -> (count, until)
SESSION_S = 8 * 3600


def session_user(handler):
    ck = handler.headers.get("Cookie") or ""
    m = re.search(r"(?:^|;\s*)utsess=([A-Za-z0-9_-]{20,})", ck)
    if not m:
        return None
    s = SESSIONS.get(m.group(1))
    if not s or s[1] < time.time():
        SESSIONS.pop(m.group(1), None)
        return None
    SESSIONS[m.group(1)] = (s[0], time.time() + SESSION_S)
    return s[0]


def login(handler, req):
    ip = handler.client_address[0]
    n, until = FAILS.get(ip, (0, 0))
    if until > time.time():
        raise Fail("Too many failed attempts, please wait %d s." % int(until - time.time()), 429)
    user, pw = req.get("user", ""), req.get("password", "")
    c = db()
    try:
        known = c.execute("SELECT 1 FROM smb_user WHERE uname=? AND uname != ?", (user, GUEST)).fetchone()
    finally:
        c.close()
    ok = known and auth_ok(user, pw)
    if not ok:
        n += 1
        FAILS[ip] = (n, time.time() + min(300, 2 ** n) if n >= 3 else 0)
        raise Fail("Wrong user name or password.", 401)
    FAILS.pop(ip, None)
    tok = secrets.token_urlsafe(32)
    SESSIONS[tok] = (user, time.time() + SESSION_S)
    return tok


# ------------------------------------------------------- UntrashApp (docs/architecture/app-api.md)
#
# The app is an UntrashMesh member with its own Ed25519 key, linked on this
# NAS to one Desk user (untrash-mesh apps.json).  It calls the same JSON API
# as the Desk, each request signed; it confirms sign-ins and, for users with
# sign-in "both", the actions in CONFIRM_ACTIONS (number matching: the
# browser shows a number, the app offers three).

APP_API = 1
MESH_DIR = os.environ.get("ZT_MESH_DIR", R + "/etc/untrash/mesh")
ZT_SIG = os.environ.get("ZT_SIG", "/usr/lib/untrash/zt-sig")
APP_AUTH = R + "/etc/untrash/app-auth.json"       # user -> {"signin": mode}
SIGNIN = ("password", "app", "both")               # password only / password or app / password and app
APP_TTL = 120                                      # seconds a request waits for the app
APP_REQ = {}                                       # id -> request (memory: a restart drops them)
APP_NONCES = {}                                    # nonce -> expiry (replay protection)
APP_LOCK = threading.Lock()
APP_STREAMED = ("/api/files/upload", "/api/downloads/torrent", "/api/update/upload")   # body not signable in v1
CONFIRM_ACTIONS = {"/api/update/install": ("Install an update", None), "/api/users/delete": ("Delete a user", "name"),
                   "/api/users/signin": ("Reset the sign-in of a user", "user"), "/api/mesh/remove": ("Remove a mesh member", "node"),
                   "/api/mesh/leave": ("Leave the mesh", None), "/api/stock/rollback": ("Go back to the stock firmware", None)}


def mesh_file(name, default):
    try:
        return json.load(open(os.path.join(MESH_DIR, name)))
    except (OSError, ValueError):
        return default


def mesh_address(mesh_id, pub):
    """The member's UntrashMesh address (as untrash-mesh derives it)."""
    h = hashlib.sha256(("untrash-mesh:" + mesh_id).encode()).digest()
    iid = hashlib.sha256(bytes.fromhex(pub)).digest()[:8]
    return str(ipaddress.IPv6Address(b"\xfd" + h[:5] + b"\0\0" + iid))


def app_nodes():
    """App members of the mesh linked to a Desk user of this NAS."""
    st, links = mesh_file("mesh.json", {}), mesh_file("apps.json", {})
    out = {}
    for k, m in ((st.get("roster") or {}).get("members") or {}).items():
        if m.get("kind") == "app" and k in links and st.get("mesh"):
            out[k] = {"pub": m["pub"], "name": m.get("name", ""), "user": links[k]["user"],
                      "addr": mesh_address(st["mesh"]["id"], m["pub"])}
    return out


def signin_mode(user):
    """The user's sign-in; without a linked app it is always "password"."""
    try:
        mode = json.load(open(APP_AUTH)).get(user, {}).get("signin", "password")
    except (OSError, ValueError):
        mode = "password"
    if mode != "password" and not any(a["user"] == user for a in app_nodes().values()):
        return "password"
    return mode if mode in SIGNIN else "password"


def signin_set(user, mode):
    try:
        d = json.load(open(APP_AUTH))
    except (OSError, ValueError):
        d = {}
    if mode == "password":
        d.pop(user, None)
    else:
        d[user] = {"signin": mode}
    os.makedirs(os.path.dirname(APP_AUTH), exist_ok=True)
    tmp = APP_AUTH + ".tmp"
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(d, f)
    os.replace(tmp, APP_AUTH)


def sig_ok(pub, msg, sig):
    with tempfile.TemporaryDirectory() as d:
        for n, b in (("k", bytes.fromhex(pub)), ("m", msg), ("s", bytes.fromhex(sig))):
            open(os.path.join(d, n), "wb").write(b)
        return subprocess.run([ZT_SIG, "verify", d + "/k", d + "/m", d + "/s"], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL).returncode == 0


def app_auth(handler, method, raw):
    """(user, node) of a request signed by a linked app, None without the
    Authorization header; a bad signature, an old time, a reused nonce or a
    request from outside UntrashMesh is refused."""
    h = handler.headers.get("Authorization") or ""
    if not h.startswith("UntrashApp "):
        return None
    f = dict(x.strip().split("=", 1) for x in h[11:].split(",") if "=" in x)
    node, ts, nonce, sig = f.get("node", ""), f.get("ts", ""), f.get("nonce", ""), f.get("sig", "")
    if not (re.fullmatch(r"[0-9a-f]{16}", node) and re.fullmatch(r"\d{9,11}", ts) and re.fullmatch(r"[0-9a-f]{16,64}", nonce)
            and re.fullmatch(r"[0-9a-f]{128}", sig)):
        raise Fail("Malformed app signature.", 401)
    now = time.time()
    if abs(now - int(ts)) > 120:
        raise Fail("App request too old (check the phone's clock).", 401)
    a = app_nodes().get(node)
    if not a:
        raise Fail("This app is not linked to a user of this NAS.", 401)
    if not os.environ.get("ZT_MESH_ADDRMAP") and handler.client_address[0] not in (a["addr"], "::ffff:" + a["addr"]):
        raise Fail("The app reaches the Desk over UntrashMesh only.", 401)
    msg = "\n".join(["UTAPP1", method, handler.path, ts, nonce, hashlib.sha256(raw).hexdigest()]).encode()
    with APP_LOCK:
        for k in [k for k, t in APP_NONCES.items() if t < now]:
            del APP_NONCES[k]
        if nonce in APP_NONCES:
            raise Fail("App request replayed.", 401)
        APP_NONCES[nonce] = now + 300
    if not sig_ok(a["pub"], msg, sig):
        raise Fail("Wrong app signature.", 401)
    return a["user"], node


def app_notify(user):
    """Tell the user's apps that a request waits (best effort: an app in the
    background polls instead)."""
    if TEST:
        return
    for a in [a for a in app_nodes().values() if a["user"] == user]:
        def go(addr=a["addr"]):
            try:
                urllib.request.urlopen(urllib.request.Request("http://[%s]:7340/v1/app-notify" % addr, data=b"{}",
                                                              headers={"Content-Type": "application/json"}), timeout=3).read()
            except (OSError, urllib.error.URLError):
                pass
        threading.Thread(target=go, daemon=True).start()


def app_request(kind, user, handler, action=None, detail=None):
    """A request the app must answer: kind login (sign-in without password),
    login2 (second factor after the password) or confirm (an action)."""
    now = time.time()
    code = secrets.randbelow(90) + 10
    others = set()
    while len(others) < 2:
        x = secrets.randbelow(90) + 10
        if x != code:
            others.add(x)
    choices = sorted(others | {code}, key=lambda _x: secrets.randbelow(1000))
    rid = secrets.token_urlsafe(24)
    ip = handler.client_address[0]
    with APP_LOCK:
        for k in [k for k, r in APP_REQ.items() if r["expires"] < now - 600]:
            del APP_REQ[k]
        live = [r for r in APP_REQ.values() if r["expires"] > now and r["state"] == "pending"]
        if sum(r["ip"] == ip for r in live) >= 5 or sum(r["user"] == user for r in live) >= 10:
            raise Fail("Too many open requests, please wait.", 429)
        APP_REQ[rid] = {"id": rid, "kind": kind, "user": user, "action": action, "detail": detail, "ip": ip,
                        "agent": (handler.headers.get("User-Agent") or "")[:200], "code": code, "choices": choices,
                        "created": int(now), "expires": now + APP_TTL, "state": "pending", "used": False,
                        "mode": signin_mode(user)}     # a request made under "password" never shows later
    app_notify(user)
    return rid, code


def app_visible(r):
    """Requests the user's app is shown: a sign-in without password only for
    users with sign-in "app", every other kind only for "both"."""
    mode = signin_mode(r["user"])
    if mode != r["mode"]:
        return False
    return (r["kind"] == "login" and mode == "app") or (r["kind"] in ("login2", "confirm") and mode == "both")


def app_requests(user):
    now = time.time()
    with APP_LOCK:
        items = [r for r in APP_REQ.values() if r["user"] == user and r["state"] == "pending" and r["expires"] > now]
    return {"requests": [{"id": r["id"], "kind": r["kind"], "action": r["action"], "detail": r["detail"], "ip": r["ip"],
                          "agent": r["agent"], "choices": r["choices"], "created": r["created"], "expires": int(r["expires"])}
                         for r in items if app_visible(r)]}


def app_answer(user, req):
    with APP_LOCK:
        r = APP_REQ.get(str(req.get("id") or ""))
        if not r or r["user"] != user or r["state"] != "pending" or r["expires"] < time.time() or not app_visible(r):
            raise Fail("No such request (or it expired).", 404)
        if req.get("approve") is True and req.get("code") == r["code"]:
            r["state"] = "approved"
        else:
            r["state"] = "denied"           # declined, or the wrong number: an unknown browser
        return {"state": r["state"]}


def app_login_poll(handler, rid):
    """Browser: the state of its sign-in request; approved -> a session (once)."""
    with APP_LOCK:
        r = APP_REQ.get(rid)
        if not r or r["kind"] not in ("login", "login2"):
            raise Fail("No such request.", 404)
        if r["state"] == "pending" and r["expires"] < time.time():
            r["state"] = "expired"
        if r["state"] != "approved":
            if r["state"] == "denied":
                n, _u = FAILS.get(handler.client_address[0], (0, 0))
                FAILS[handler.client_address[0]] = (n + 1, time.time() + min(300, 2 ** (n + 1)) if n + 1 >= 3 else 0)
            return {"state": r["state"]}, None
        if r["used"]:
            return {"state": "used"}, None
        r["used"] = True
    tok = secrets.token_urlsafe(32)
    SESSIONS[tok] = (r["user"], time.time() + SESSION_S)
    FAILS.pop(handler.client_address[0], None)
    return {"state": "approved"}, tok


def confirm_action(user, path, req, handler, by_app):
    """Users with sign-in "both" confirm the actions in CONFIRM_ACTIONS in
    the app (a request the app signs is confirmed by itself).  Answers 428
    with the request; the browser repeats the call with confirm=<id>."""
    if path not in CONFIRM_ACTIONS or by_app or signin_mode(user) != "both":
        return
    action, key = CONFIRM_ACTIONS[path]
    detail = str(req.get(key) or "")[:80] if key else None
    with APP_LOCK:
        r = APP_REQ.get(str(req.get("confirm") or ""))
        if (r and r["kind"] == "confirm" and r["user"] == user and r["action"] == action and r["detail"] == detail
                and r["state"] == "approved" and not r["used"] and r["expires"] > time.time() - 60):
            r["used"] = True
            return
    rid, code = app_request("confirm", user, handler, action, detail)
    raise Fail("Confirm this in the UntrashApp.", 428, {"confirm": rid, "code": code, "action": action})


def app_confirm_poll(user, rid):
    with APP_LOCK:
        r = APP_REQ.get(rid)
        if not r or r["kind"] != "confirm" or r["user"] != user:
            raise Fail("No such request.", 404)
        if r["state"] == "pending" and r["expires"] < time.time():
            r["state"] = "expired"
        return {"state": r["state"]}


def signin_change(user, req):
    """The user's own sign-in mode; needs the password."""
    mode = req.get("mode")
    if mode not in SIGNIN:
        raise Fail("Unknown sign-in.")
    if not auth_ok(user, str(req.get("password") or "")):
        raise Fail("Wrong password.", 403)
    if mode != "password" and not any(a["user"] == user for a in app_nodes().values()):
        raise Fail("Pair the UntrashApp with this user first.")
    signin_set(user, mode)
    return {"signin": signin_mode(user)}


def signin_reset(req):
    """Admin: a user's sign-in back to the password (lost phone)."""
    if req.get("user") not in [u["name"] for u in users()]:
        raise Fail("Unknown user.", 404)
    signin_set(req["user"], "password")
    return {}


# ------------------------------------------------- office bridge: WOPI host (docs/architecture/office.md)
#
# An office server elsewhere (Collabora Online / Nextcloud Office, ONLYOFFICE)
# edits documents that stay on the NAS: the Desk asks it how to open a file
# type (discovery), the browser opens the editor with a short-lived token,
# and the editor fetches and saves the file here under /wopi with that token.
# Share rights are checked on every request, as for the Desk's own Files.

OFFICE_CONF = R + "/etc/untrash/office.json"
WOPI_KEY = R + "/etc/untrash/wopi.key"
WOPI_TTL = 10 * 3600                      # a token lives as long as a long working day
WOPI_LOCK_S = 30 * 60                     # WOPI: a lock expires after 30 minutes
WOPI_LOCKS = {}                           # file id -> (lock string, expiry)
WOPI_MAX = 512 << 20                      # largest document saved through WOPI
DISCOVERY = {"t": 0, "url": None, "actions": {}}


def office_load():
    try:
        c = json.load(open(OFFICE_CONF))
    except (OSError, ValueError):
        c = {}
    return {"server": c.get("server", ""), "wopi_base": c.get("wopi_base", ""), "insecure": bool(c.get("insecure"))}


def office_save(req):
    """Admin: the office server's address and the address under which that
    server reaches this NAS (WOPISrc); both empty = office bridge off."""
    srv, base = str(req.get("server") or "").strip().rstrip("/"), str(req.get("wopi_base") or "").strip().rstrip("/")
    for v, what in ((srv, "Office server"), (base, "Address of this NAS")):
        if v and not re.fullmatch(r"https?://[A-Za-z0-9.\-\[\]:]+(/[A-Za-z0-9._~/-]*)?", v):
            raise Fail("%s: an address like https://office.example.org:9980" % what)
    if bool(srv) != bool(base):
        raise Fail("Enter both addresses (or neither to switch the office bridge off).")
    os.makedirs(os.path.dirname(OFFICE_CONF), exist_ok=True)
    with open(OFFICE_CONF, "w") as f:
        json.dump({"server": srv, "wopi_base": base, "insecure": bool(req.get("insecure"))}, f)
    DISCOVERY.update(t=0, url=None, actions={})
    return office_state(check=bool(srv))


def discovery(force=False):
    """{extension: (action, urlsrc)} from the office server's WOPI discovery
    (cached for an hour); "edit" wins over "view"."""
    c = office_load()
    if not c["server"]:
        return {}
    if not force and DISCOVERY["url"] == c["server"] and time.time() - DISCOVERY["t"] < 3600:
        return DISCOVERY["actions"]
    import ssl
    import xml.etree.ElementTree as ET
    ctx = ssl.create_default_context()
    if c["insecure"]:
        ctx.check_hostname, ctx.verify_mode = False, ssl.CERT_NONE
    try:
        data = urllib.request.urlopen(c["server"] + "/hosting/discovery", timeout=10, context=ctx).read(4 << 20)
        root = ET.fromstring(data)
    except (OSError, urllib.error.URLError, ET.ParseError, ValueError) as e:
        raise Fail("The office server does not answer (%s)." % (getattr(e, "reason", None) or e), 502)
    acts = {}
    for a in root.iter("action"):
        ext, name, src = (a.get("ext") or "").lower(), a.get("name"), a.get("urlsrc") or ""
        if ext and name in ("edit", "view") and src.startswith(("http://", "https://")):
            if ext not in acts or (name == "edit" and acts[ext][0] != "edit"):
                acts[ext] = (name, re.sub(r"<[^>]*>", "", src))      # placeholders like <ui=UI_LLCC&> stay out
    DISCOVERY.update(t=time.time(), url=c["server"], actions=acts)
    return acts


def office_state(check=False):
    c = office_load()
    out = dict(c, enabled=bool(c["server"]), exts=[])
    if c["server"] and check:
        out["exts"] = sorted(discovery(force=True))
    elif c["server"]:
        try:
            out["exts"] = sorted(discovery())
        except Fail as e:
            out["error"] = str(e)
    return out


def wopi_key():
    try:
        k = open(WOPI_KEY, "rb").read()
        if len(k) == 32:
            return k
    except OSError:
        pass
    os.makedirs(os.path.dirname(WOPI_KEY), exist_ok=True)
    k = os.urandom(32)
    with open(os.open(WOPI_KEY, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "wb") as f:
        f.write(k)
    return k


def wopi_id(share, path):
    """Stable per file, so two people editing the same file share a session."""
    return hashlib.sha256(("%s\0%s" % (share, path.strip("/"))).encode()).hexdigest()[:32]


def wopi_token(user, share, path, exp):
    body = base64.urlsafe_b64encode(json.dumps({"u": user, "s": share, "p": path.strip("/"), "e": exp},
                                               separators=(",", ":")).encode()).decode().rstrip("=")
    return body + "." + hmac.new(wopi_key(), body.encode(), hashlib.sha256).hexdigest()


def wopi_check(fid, token, write=False):
    """(user, share, path, full path) for a valid token of this file id."""
    try:
        body, mac = token.split(".", 1)
        if not hmac.compare_digest(mac, hmac.new(wopi_key(), body.encode(), hashlib.sha256).hexdigest()):
            raise ValueError
        t = json.loads(base64.urlsafe_b64decode(body + "=" * (-len(body) % 4)))
    except (ValueError, TypeError):
        raise Fail("Invalid access token.", 401)
    if t["e"] < time.time() or wopi_id(t["s"], t["p"]) != fid:
        raise Fail("Invalid access token.", 401)
    _b, full = resolve(t["u"], t["s"], t["p"], write=write)     # the rights of now, not of the time of opening
    if not os.path.isfile(full):
        raise Fail("File not found.", 404)
    return t["u"], t["s"], t["p"], full


def office_open(user, req):
    """Browser: the editor URL and token for a file of a share."""
    share, path = str(req.get("share") or ""), str(req.get("path") or "").strip("/")
    _b, full = resolve(user, share, path)
    if not os.path.isfile(full):
        raise Fail("File not found.", 404)
    if os.path.getsize(full) > WOPI_MAX:
        raise Fail("Document too large for the office server (over 512 MB).")
    c = office_load()
    if not c["server"]:
        raise Fail("No office server is set up (Settings → Office).")
    ext = os.path.splitext(path)[1].lower().lstrip(".")
    act = discovery().get(ext)
    if not act:
        raise Fail("The office server cannot open .%s files." % ext)
    exp = int(time.time() + WOPI_TTL)
    src = "%s/wopi/files/%s" % (c["wopi_base"], wopi_id(share, path))
    lang = re.sub(r"[^a-z-]", "", str(req.get("lang") or "en"))[:5]
    url = act[1] + ("" if act[1].endswith(("?", "&")) else ("&" if "?" in act[1] else "?")) + \
        urllib.parse.urlencode({"WOPISrc": src, "lang": lang})
    return {"url": url, "access_token": wopi_token(user, share, path, exp), "access_token_ttl": exp * 1000, "action": act[0]}


def wopi_version(full):
    st = os.stat(full)
    return "%d-%d" % (st.st_mtime_ns, st.st_size)


def wopi_lock(fid):
    with LOCK:
        lk = WOPI_LOCKS.get(fid)
        if lk and lk[1] < time.time():
            WOPI_LOCKS.pop(fid, None)
            return None
        return lk[0] if lk else None


def wopi_handle(handler, method, rest, q):
    """WOPI host endpoints: CheckFileInfo, GetFile, PutFile, Lock, GetLock,
    RefreshLock, Unlock, UnlockAndRelock.  No session: the token decides."""
    m = re.fullmatch(r"files/([0-9a-f]{32})(/contents)?", rest)
    if not m:
        raise Fail("Unknown.", 404)
    fid, contents, token = m.group(1), bool(m.group(2)), q.get("access_token", "")
    hdr = lambda k: handler.headers.get(k) or ""
    override = hdr("X-WOPI-Override").upper()
    if method == "GET" and not contents:                       # CheckFileInfo
        user, share, path, full = wopi_check(fid, token)
        st = os.stat(full)
        try:
            resolve(user, share, path, write=True)
            can_write = os.access(full, os.W_OK) or TEST
        except Fail:
            can_write = False
        return handler.reply(200, {
            "BaseFileName": os.path.basename(full), "Size": st.st_size, "Version": wopi_version(full),
            "OwnerId": share, "UserId": user, "UserFriendlyName": user, "UserCanWrite": can_write, "ReadOnly": not can_write,
            "SupportsLocks": True, "SupportsGetLock": True, "SupportsUpdate": True, "UserCanNotWriteRelative": True,
            "SupportsRename": False, "UserCanRename": False,
            "LastModifiedTime": datetime.datetime.fromtimestamp(st.st_mtime, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ")})
    if method == "GET" and contents:                           # GetFile
        _u, _s, _p, full = wopi_check(fid, token)
        if os.path.getsize(full) > WOPI_MAX:
            raise Fail("Document too large.", 413)
        return handler.reply(200, open(full, "rb").read(), "application/octet-stream",
                             headers=[("X-WOPI-ItemVersion", wopi_version(full))])
    if method != "POST":
        raise Fail("Unknown.", 404)
    if contents:                                               # PutFile
        if override not in ("", "PUT"):
            raise Fail("Unknown.", 400)
        n = int(hdr("Content-Length") or 0)
        if n > WOPI_MAX:
            raise Fail("Document too large.", 413)
        user, _s, _p, full = wopi_check(fid, token, write=True)
        body = handler.rfile.read(n) if n else b""
        cur = wopi_lock(fid)
        if cur and cur != hdr("X-WOPI-Lock"):
            # locked by another editor session.  The WOPI rule "no save without
            # a lock" is not applied: editors that never lock must still save.
            return handler.reply(409, {"error": "lock mismatch"}, headers=[("X-WOPI-Lock", cur or "")])
        st = os.stat(full)
        tmp = os.path.join(os.path.dirname(full), ".%s.untrash-office" % os.path.basename(full))
        with open(tmp, "wb") as f:
            f.write(body)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, st.st_mode & 0o7777)
        if not TEST:
            os.chown(tmp, st.st_uid, st.st_gid)        # the file keeps its owner (stock rights)
        os.replace(tmp, full)
        return handler.reply(200, {}, headers=[("X-WOPI-ItemVersion", wopi_version(full))])
    if override in ("LOCK", "GET_LOCK", "REFRESH_LOCK", "UNLOCK"):
        write = override != "GET_LOCK"
        wopi_check(fid, token, write=write)
        lock, old, cur = hdr("X-WOPI-Lock"), hdr("X-WOPI-OldLock"), wopi_lock(fid)
        if override == "GET_LOCK":
            return handler.reply(200, {}, headers=[("X-WOPI-Lock", cur or "")])
        if not lock or len(lock) > 1024:
            raise Fail("X-WOPI-Lock missing.", 400)
        with LOCK:
            if override == "LOCK" and old:                     # UnlockAndRelock
                if cur != old:
                    return handler.reply(409, {}, headers=[("X-WOPI-Lock", cur or "")])
                WOPI_LOCKS[fid] = (lock, time.time() + WOPI_LOCK_S)
            elif override == "LOCK":
                if cur and cur != lock:
                    return handler.reply(409, {}, headers=[("X-WOPI-Lock", cur)])
                WOPI_LOCKS[fid] = (lock, time.time() + WOPI_LOCK_S)
            elif cur != lock:                                  # REFRESH_LOCK, UNLOCK
                return handler.reply(409, {}, headers=[("X-WOPI-Lock", cur or "")])
            elif override == "REFRESH_LOCK":
                WOPI_LOCKS[fid] = (lock, time.time() + WOPI_LOCK_S)
            else:
                WOPI_LOCKS.pop(fid, None)
        return handler.reply(200, {})
    return handler.reply(501, {"error": "not supported"})      # PUT_RELATIVE, RENAME_FILE, ...


