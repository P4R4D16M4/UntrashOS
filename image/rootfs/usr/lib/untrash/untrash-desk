def dlna_page():
    """minidlna's own status page: library counts and the clients it knows."""
    import urllib.request
    try:
        h = urllib.request.urlopen(DLNA_URL, timeout=3).read().decode("utf-8", "replace")
    except (OSError, ValueError):
        return None
    cells = lambda row: [re.sub(r"<[^>]+>", "", x).strip() for x in re.findall(r"<td[^>]*>(.*?)</td>", row, re.S)]  # noqa: E731
    rows = [cells(r) for r in re.findall(r"<tr[^>]*>(.*?)</tr>", h, re.S)]
    lib = {}
    for r in rows:
        if len(r) == 2 and r[1].isdigit():
            k = r[0].lower()
            lib["audio" if "audio" in k else "video" if "video" in k else "image" if "image" in k else k] = int(r[1])
    clients = [{"type": r[1], "ip": r[2], "connections": int(r[4]) if r[4].isdigit() else 0}
               for r in rows if len(r) >= 5 and r[0].isdigit() and re.fullmatch(r"[\d.:a-fA-F]+", r[2])]
    return {"library": lib, "clients": clients}


def media_state():
    s = settings_load()
    cfg = load_module(CFGTOOL, "untrash_config")
    page = dlna_page()
    acts = untrash_live.activities(R)["activities"]
    sh = [{"name": x["name"], "media": x["media"], "present": x["present"],
           "published": bool(x["media"] and x["enabled"] and x["present"] and cfg.media_dir_used(R + x["path"]))}
          for x in shares() if x["enabled"]]
    try:
        dbsize = os.path.getsize(DLNA_DB)
        scanned = int(os.path.getmtime(DLNA_DB))
    except OSError:
        dbsize = scanned = 0
    return {"active": s["services"]["mediaserver"]["active"], "name": s["hostname"],
            "running": page is not None, "library": (page or {}).get("library", {}), "clients": (page or {}).get("clients", []),
            "indexing": any(a["kind"] == "index" for a in acts),
            "streams": sum(int(re.match(r"\d+", a.get("text", "")).group()) if re.match(r"\d+", a.get("text", "")) else 1
                           for a in acts if a["kind"] == "stream"),
            "db_size": dbsize, "db_time": scanned, "shares": sh, "tv": TV.state()}


def media_save(req):
    """Media server on/off and the media types per share (stock: mdaserv_public_type)."""
    masks = req.get("shares") or {}
    if masks:
        known = {x["name"] for x in shares()}
        c = db()
        try:
            for name, m in masks.items():
                if name not in known:
                    raise Fail("Unknown share.", 404)
                c.execute("UPDATE smb_share SET mdaserv_public_type=? WHERE s_name=?", (int(m) & 7, name))
            c.commit()
        finally:
            c.close()
        media_sync()
    s = settings_load()
    if "active" in req:
        s["services"]["mediaserver"]["active"] = bool(req["active"])
    settings_save(s)
    if "lan_open" in req:
        TV.set_lan_open(req["lan_open"])
    return media_state()


def media_rescan(_req):
    """Rebuild the library from scratch (minidlna keeps a stale database otherwise)."""
    if not settings_load()["services"]["mediaserver"]["active"]:
        raise Fail("The media server is off.")
    sysrun(["systemctl", "stop", "minidlna"], check=False)
    if not TEST:
        for f in ("files.db", "art_cache"):
            x = os.path.join(os.path.dirname(DLNA_DB), f)
            shutil.rmtree(x, ignore_errors=True) if os.path.isdir(x) else (os.path.exists(x) and os.unlink(x))
    sysrun(["systemctl", "start", "--no-block", "minidlna"], check=False)
    return {}


