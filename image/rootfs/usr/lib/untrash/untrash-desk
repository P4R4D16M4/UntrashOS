def check_password(pw):
    if not isinstance(pw, str) or len(pw) < 8 or len(pw) > 64 or "\n" in pw or "\0" in pw:
        raise Fail("The password needs 8 to 64 characters.")


def smb_set_password(name, uid, pw):
    nt = untrash_auth.nt_hash(pw)
    c = db()
    try:
        c.execute("UPDATE smb_user SET passwd=? WHERE uname=?", ("X" * 32 + ":" + nt, name))
        if name == "admin":
            sh = untrash_auth.unix_crypt(pw, "$6$" + secrets.token_hex(8) + "$")
            c.execute("INSERT OR REPLACE INTO ugs_misc VALUES ('admin_shadow_passwd', ?)", (sh,))
            sysrun(["usermod", "-p", sh, "admin"])
        c.commit()
    finally:
        c.close()
    line = "%s:%d:%s:%s:[U          ]:LCT-00000000:\n" % (name, uid, "X" * 32, nt)
    if TEST:
        SYSLOG.append(["pdbedit-import", name])
        return
    tmp = os.path.join("/run/untrash", "pw-%s" % secrets.token_hex(6))
    os.makedirs("/run/untrash", exist_ok=True)
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        os.write(fd, line.encode())
        os.close(fd)
        sysrun(["pdbedit", "-x", "-u", name], check=False)
        sysrun(["pdbedit", "-i", "smbpasswd:" + tmp, "-e", "tdbsam"])
    finally:
        os.unlink(tmp)


def user_create(req):
    name, pw = req.get("name", ""), req.get("password", "")
    if not NAME_RE.match(name) or name.lower() in ("root", "admin", GUEST, "nobody", EVERYONE):
        raise Fail("Invalid user name.")
    check_password(pw)
    c = db()
    try:
        if c.execute("SELECT 1 FROM smb_user WHERE uname=? COLLATE NOCASE", (name,)).fetchone():
            raise Fail("This user already exists.")
        uid = max(503, c.execute("SELECT max(uid) FROM smb_user").fetchone()[0] or 0) + 1
        c.execute("INSERT INTO smb_user VALUES (?,?,?,?,?,?)",
                  (uid, name, "user-create", "user", "", (req.get("description") or "")[:60]))
        c.execute("INSERT INTO group_member VALUES (500, ?, ?, ?)", (EVERYONE, uid, name))
        c.commit()
    finally:
        c.close()
    sysrun(["useradd", "-u", str(uid), "-g", "500", "-M", "-d", "/nonexistent", "-s", "/usr/sbin/nologin",
            "-c", (req.get("description") or "")[:60], name])
    smb_set_password(name, uid, pw)
    for g in req.get("groups") or []:
        group_member(g, name, True)
    resmb()
    return {"uid": uid}


def user_delete(req):
    name = req.get("name", "")
    if name in ("admin", GUEST):
        raise Fail("Built-in users remain.")
    c = db()
    try:
        if not c.execute("SELECT 1 FROM smb_user WHERE uname=?", (name,)).fetchone():
            raise Fail("Unknown user.", 404)
        for t in ("smb_user", "group_member", "share_user_privilege"):
            c.execute("DELETE FROM %s WHERE uname=?" % t, (name,))
        c.commit()
    finally:
        c.close()
    sysrun(["pdbedit", "-x", "-u", name], check=False)
    sysrun(["userdel", name], check=False)
    try:
        os.remove(prefs_path(name))
    except OSError:
        pass
    resmb()
    return {}


# ------------------------------------------------------------ UntrashMesh

MESH_TOOL = os.environ.get("ZT_MESH_TOOL", "/usr/lib/untrash/untrash-mesh")


def mesh_run(*args):
    """untrash-mesh prints one JSON object; {"error": ...} becomes a Fail."""
    r = subprocess.run([MESH_TOOL] + [str(a) for a in args], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=90)
    try:
        out = json.loads((r.stdout.strip().splitlines() or ["{}"])[-1])
    except ValueError:
        raise Fail("UntrashMesh: %s" % (r.stderr.strip()[-200:] or "no answer"))
    if out.get("error"):
        raise Fail(out["error"])
    return out


def mesh_name(v, what="Name"):
    v = str(v or "").strip()
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9 ._-]{0,39}", v):
        raise Fail("%s: letters, digits, space . _ - (up to 40 characters)." % what)
    return v


def mesh_post(op, req):
    if op == "create":
        return mesh_run("create", mesh_name(req.get("name")))
    if op == "invite":
        h = int(req.get("hours") or 24)
        if not 1 <= h <= 168:
            raise Fail("Valid for 1 to 168 hours.")
        return mesh_run("invite", h)
    if op == "join":
        inv = re.sub(r"\s+", "", str(req.get("invitation") or ""))
        if not re.fullmatch(r"[A-Za-z0-9_-]{20,4000}", inv):
            raise Fail("This is not an UntrashMesh invitation.")
        return mesh_run("join", inv)
    if op == "remove":
        if not re.fullmatch(r"[0-9a-f]{16}", str(req.get("node") or "")):
            raise Fail("Unknown member.")
        return mesh_run("remove", req["node"])
    if op == "leave":
        return mesh_run("leave")
    if op == "rename":
        return mesh_run("rename", mesh_name(req.get("name"), "Name in the mesh"))
    if op == "share":
        if not re.fullmatch(r"[0-9a-f]{16}", str(req.get("node") or "")):
            raise Fail("Unknown member.")
        local = {x["name"]: x for x in shares() if x["enabled"] and x["present"] and not x["path"].startswith("/p-data/")}
        spec = {}
        for name, mode in (req.get("shares") or {}).items():
            if mode not in ("ro", "rw") or name not in local:
                raise Fail("Unknown share or right: %s" % name)
            spec[name] = {"mode": mode, "path": local[name]["path"]}
        return mesh_run("share", req["node"], json.dumps(spec))
    if op in ("mirror-start", "mirror-accept"):
        vol = next((v for v in volumes() if v["id"] == req.get("volume") and v["kind"] == "intern"), None)
        if not vol:
            raise Fail("Choose a volume.")
        if op == "mirror-start":
            if vol.get("host"):
                raise Fail("The volume of the running system cannot be mirrored.")
            if not re.fullmatch(r"[0-9a-f]{16}", str(req.get("node") or "")):
                raise Fail("Unknown member.")
            return mesh_run("mirror-start", vol["path"], vol["label"], req["node"])
        return mesh_run("mirror-accept", mirror_id(req), vol["path"])
    if op in ("pair", "app-link"):
        name = str(req.get("user") or "")
        if name and name not in [u["name"] for u in users() if u["name"] != GUEST]:
            raise Fail("Unknown user.", 404)
        if op == "pair":
            if not name:
                raise Fail("Choose the user the app signs in as.")
            h = int(req.get("hours") or 1)
            if not 1 <= h <= 24:
                raise Fail("Valid for 1 to 24 hours.")
            return mesh_run("invite", h, name)
        if not re.fullmatch(r"[0-9a-f]{16}", str(req.get("node") or "")):
            raise Fail("Unknown member.")
        return mesh_run("app-link", req["node"], name)
    if op in ("mirror-decline", "mirror-stop"):
        return mesh_run(op, mirror_id(req))
    raise Fail("Unknown.", 404)


def mirror_id(req):
    if not re.fullmatch(r"[0-9a-f]{8}", str(req.get("id") or "")):
        raise Fail("Unknown mirror.")
    return req["id"]


