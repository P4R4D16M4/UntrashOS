def files_search(user, q):
    """Names containing q below a folder (case-insensitive), at most 300
    hits or 8 seconds."""
    base, full = resolve(user, q.get("share", ""), q.get("path", ""))
    needle = (q.get("q") or "").strip().lower()
    if len(needle) < 2:
        raise Fail("At least 2 characters.")
    out, t0, partial = [], time.time(), False
    for d, dirs, files in os.walk(full):
        dirs[:] = sorted(x for x in dirs if x not in (IMP.RECYCLE_FN, IMP.RECYCLE_RBM_FN, ".system", ".media"))
        for n in dirs + sorted(files):
            if needle in n.lower():
                fp = os.path.join(d, n)
                try:
                    st = os.stat(fp, follow_symlinks=False)
                except OSError:
                    continue
                out.append({"path": os.path.relpath(fp, base), "name": n, "dir": n in dirs, "size": st.st_size, "mtime": int(st.st_mtime)})
        if len(out) >= 300 or time.time() - t0 > 8:
            partial = True
            break
    return {"results": out[:300], "partial": partial}


def files_size(user, q):
    """Size of a folder (files, folders), at most 10 seconds of counting."""
    _b, full = resolve(user, q.get("share", ""), q.get("path", ""))
    total = files = dirs = 0
    t0, partial = time.time(), False
    for d, ds, fs in os.walk(full):
        dirs += len(ds)
        for f in fs:
            fp = os.path.join(d, f)
            if not os.path.islink(fp):
                try:
                    total += os.path.getsize(fp)
                    files += 1
                except OSError:
                    pass
        if time.time() - t0 > 10:
            partial = True
            break
    return {"size": total, "files": files, "dirs": dirs, "partial": partial}


