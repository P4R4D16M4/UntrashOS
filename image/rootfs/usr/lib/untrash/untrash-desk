SOUND = os.environ.get("ZT_SOUND_TOOL", "/usr/lib/untrash/untrash-sound")
SOUND_USER = os.environ.get("ZT_SOUND_USER", R + "/etc/untrash/sounds.json")
SOUND_EVENTS = ("boot", "shutdown", "error", "critical", "success", "connect", "disconnect", "warning", "standby")


def sound_notes(notes):
    """[[hz, ms(, tie)]] as untrash-sound plays them: rest or 100..4000 Hz
    (the PWM5 driver), 1..5000 ms, at most 4000 notes and 60 s."""
    notes = notes or []
    if len(notes) > 4000:
        raise Fail("More than 4000 tones.")
    out, total = [], 0
    for n in notes:
        hz, ms = int(n[0]), int(n[1])
        if not (hz == 0 or 100 <= hz <= 4000) or not 0 < ms <= 5000:
            raise Fail("Tone out of range (100–4000 Hz, 1–5000 ms): %s" % (n,))
        total += ms
        out.append([hz, ms, 1] if len(n) > 2 and n[2] else [hz, ms])
    if not out:
        raise Fail("No tones.")
    if total > 60000:
        raise Fail("Longer than 60 s.")
    return out


def sound_score(score):
    """The editor's own data (patterns, blocks, tempo), kept as it is."""
    if score is None:
        return None
    if not isinstance(score, dict) or len(json.dumps(score)) > 200000:
        raise Fail("Score too large or not an object.")
    return score


def sound_state():
    return json.loads(read([SOUND, "show"]) or "{}")


def sound_user():
    try:
        return json.load(open(SOUND_USER))
    except (OSError, ValueError):
        return {"events": {}}


def sound_write(d):
    os.makedirs(os.path.dirname(SOUND_USER), exist_ok=True)
    tmp = SOUND_USER + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f, indent=1)
    os.replace(tmp, SOUND_USER)


def sound_save(req):
    """{"event", "notes": [[hz, ms]], "tempo"} saves; {"event", "reset": true} back to built-in."""
    ev = req.get("event")
    if ev not in SOUND_EVENTS:
        raise Fail("Unknown event.")
    d = sound_user()
    if req.get("reset"):
        d.setdefault("events", {}).pop(ev, None)
    else:
        tempo = float(req.get("tempo") or 1.0)
        if not 0.25 <= tempo <= 4.0:
            raise Fail("Tempo 0.25 to 4.")
        d.setdefault("events", {})[ev] = {"notes": sound_notes(req.get("notes")), "tempo": tempo}
        if req.get("score") is not None:
            d["events"][ev]["score"] = sound_score(req.get("score"))
    sound_write(d)
    return sound_state()


def sound_play(req):
    """Play on the NAS buzzer, in the background: a saved event or a score."""
    if req.get("stop"):
        subprocess.Popen([SOUND, "stop"])
        return {}
    if req.get("event"):
        if req["event"] not in SOUND_EVENTS:
            raise Fail("Unknown event.")
        subprocess.Popen([SOUND, "play", req["event"]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return {}
    body = json.dumps({"notes": sound_notes(req.get("notes")), "tempo": float(req.get("tempo") or 1.0)})
    p = subprocess.Popen([SOUND, "play-json"], stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         text=True)
    threading.Thread(target=p.communicate, args=(body,), daemon=True).start()
    return {}


def sound_import(req):
    """A sound set (soundset.json: events -> notes [{frequency_hz, duration_ms}])
    becomes the user scores of the events it names."""
    ss = req.get("soundset") or {}
    evs = ss.get("events") if isinstance(ss, dict) else None
    if not isinstance(evs, dict):
        raise Fail("Not a sound set (events missing).")
    d, n = sound_user(), 0
    for ev, v in evs.items():
        if ev not in SOUND_EVENTS or not isinstance(v, dict):
            continue
        notes = [[x.get("frequency_hz", 0), x.get("duration_ms", 0)] + ([1] if x.get("tie") else []) if isinstance(x, dict) else x
                 for x in v.get("notes", [])]
        d.setdefault("events", {})[ev] = {"notes": sound_notes(notes), "tempo": float(v.get("tempo", 1.0) or 1.0),
                                         "source": str(ss.get("title", "Import"))[:80]}
        if isinstance(v.get("score"), dict):
            d["events"][ev]["score"] = sound_score(v["score"])
        n += 1
    if not n:
        raise Fail("The sound set contains no known event.")
    sound_write(d)
    st = sound_state()
    st["imported"] = n
    return st


# ------------------------------------------------------------ way D (stock)

def stock_backup():
    """UntrashOS stick with the stock flash backup of this NAS (install run)."""
    cand = os.environ.get("ZT_DESK_STICK") if TEST else None
    mnts = [cand] if cand else []
    if not cand:
        for line in first("/proc/mounts").splitlines():
            p = line.split()
            if len(p) > 2 and p[2] == "vfat" and os.path.isdir(os.path.join(p[1], "UNTRASH")):
                mnts.append(p[1])
        if not mnts:
            dev = read(["blkid", "-L", "UNTRASHPK"]).strip()
            if dev:
                os.makedirs(STICK_MNT, exist_ok=True)
                if subprocess.run(["mount", "-o", "ro", dev, STICK_MNT]).returncode == 0:
                    mnts.append(STICK_MNT)
    for m in mnts:
        runs = []
        for d in sorted(glob.glob(os.path.join(m, "UNTRASH", "install-*"))):
            try:
                dev = dict(l.strip().split("=", 1) for l in open(os.path.join(d, "device.env")) if "=" in l)
                done = "RESULT DONE" in open(os.path.join(d, "install.log"), errors="replace").read()
            except OSError:
                continue
            if done:
                runs.append({"name": os.path.basename(d), "dir": d, "device": dev,
                             "verified": os.path.isfile(os.path.join(d, "flash", "VERIFIED"))})
        if runs:
            return {"mnt": m, "run": runs[-1],
                    "markers": [x for x in ("ROLLBACK", "ROLLBACK_DONE", "ROLLBACK_FAILED")
                                if os.path.exists(os.path.join(m, "UNTRASH", x))]}
    return None


def stock_rollback(req):
    if req.get("confirm") != "STOCK":
        raise Fail("Type STOCK to confirm.")
    st = stock_backup()
    if not st:
        raise Fail("No UntrashOS stick with this NAS's stock backup found.")
    d, dev = st["run"]["dir"], st["run"]["device"]
    for f, key in (("mtd2-before-a.bin", "ENV_OLD_SHA256"), ("mtd%s-before-a.bin" % dev.get("LOADER_MTD", "6"), "KX_OLD_SHA256")):
        h = hashlib.sha256(open(os.path.join(d, f), "rb").read()).hexdigest()
        if h != dev.get(key):
            raise Fail("Backup %s/%s does not match the installation's checksum." % (st["run"]["name"], f))
    u = os.path.join(st["mnt"], "UNTRASH")
    if not TEST:
        subprocess.run(["mount", "-o", "remount,rw", st["mnt"]], check=False)
    for m in ("ROLLBACK_FAILED", "ROLLBACK_DONE", "rollback-stage1.log"):
        if os.path.exists(os.path.join(u, m)):
            os.replace(os.path.join(u, m), os.path.join(u, "%s.old-%s" % (m, time.strftime("%Y%m%d-%H%M%S"))))
    open(os.path.join(u, "ROLLBACK"), "w").close()
    os.sync()
    if not TEST:
        subprocess.run(["mount", "-o", "remount,ro", st["mnt"]], check=False)
    power({"action": "reboot"})
    return {"loader_slot": dev.get("LOADER_SLOT")}


# ------------------------------------------------------------------ files

def share_access(user):
    if is_admin(user):
        return {x["name"]: {"path": x["path"], "access": "rw"} for x in shares() if x["enabled"]}
    stock = IMP.Stock(CONFIG)
    gl = [g for _gid, g, _t, _d in stock.groups() if user in stock.members(g)] + [EVERYONE]
    return IMP.user_access(stock, user, gl)


def resolve(user, share, rel, write=False):
    acc = share_access(user).get(share)
    if not acc or acc["access"] == "deny":
        raise Fail("No access to this share.", 403)
    if write and acc["access"] != "rw":
        raise Fail("Read-only access.", 403)
    base = os.path.realpath(R + acc["path"])
    full = os.path.realpath(os.path.join(base, (rel or "").lstrip("/")))
    if full != base and not full.startswith(base + "/"):
        raise Fail("Path outside the share.", 403)
    if os.path.basename(full) in (IMP.RECYCLE_FN, IMP.RECYCLE_RBM_FN):
        raise Fail("Protected file.", 403)
    return base, full


def owner_of(user):
    c = db()
    try:
        r = c.execute("SELECT uid FROM smb_user WHERE uname=?", (user,)).fetchone()
        return r[0] if r else 0
    finally:
        c.close()


def files_list(user, q):
    base, full = resolve(user, q.get("share", ""), q.get("path", ""))
    if not os.path.isdir(full):
        raise Fail("Not a folder.", 404)
    out = []
    for e in sorted(os.scandir(full), key=lambda e: (not e.is_dir(), e.name.lower())):
        if e.name.startswith(".") and e.name in (IMP.RECYCLE_FN, IMP.RECYCLE_RBM_FN, ".system", ".media"):
            continue
        try:
            st = e.stat(follow_symlinks=False)
        except OSError:
            continue
        out.append({"name": e.name, "dir": e.is_dir(follow_symlinks=False), "size": st.st_size, "mtime": int(st.st_mtime)})
    return {"entries": out, "path": os.path.relpath(full, base) if full != base else "", "recycle": share_recycle(q.get("share", ""))}


RECYCLE_DIR = "recycle"            # Samba vfs recycle:repository of a share with recycle = y (stock)


def share_recycle(share):
    c = db()
    try:
        r = c.execute("SELECT recycle FROM smb_share WHERE s_name=?", (share,)).fetchone()
        return bool(r and r[0] == "y")
    finally:
        c.close()


def own(path, user, mode=0o777):
    """New files and folders as uploads make them: the user's, group everyone."""
    os.chmod(path, mode)
    if not TEST:
        os.chown(path, owner_of(user), 500)


def free_name(path):
    """path, or "name (2).ext", "name (3).ext", ... if it exists."""
    if not os.path.lexists(path):
        return path
    d, n = os.path.split(path)
    stem, ext = (n, "") if os.path.isdir(path) else os.path.splitext(n)
    i = 2
    while os.path.lexists(os.path.join(d, "%s (%d)%s" % (stem, i, ext))):
        i += 1
    return os.path.join(d, "%s (%d)%s" % (stem, i, ext))


def to_recycle(base, full):
    """Into the share's recycle bin, the folder tree kept, as Samba's
    recycle module does (keeptree, versions: "Copy #n of name")."""
    rel = os.path.relpath(full, base)
    dst = os.path.join(base, RECYCLE_DIR, rel)
    os.makedirs(os.path.dirname(dst), mode=0o777, exist_ok=True)
    if os.path.lexists(dst):
        d, n = os.path.split(dst)
        i = 1
        while os.path.lexists(os.path.join(d, "Copy #%d of %s" % (i, n))):
            i += 1
        dst = os.path.join(d, "Copy #%d of %s" % (i, n))
    os.rename(full, dst)


def files_op(user, req):
    op, share = req.get("op"), req.get("share", "")
    if op == "delete" and isinstance(req.get("paths"), list):          # several at once
        n = 0
        for pth in req["paths"][:5000]:
            files_op(user, {"op": "delete", "share": share, "path": str(pth)})
            n += 1
        return {"deleted": n}
    _b, full = resolve(user, share, req.get("path", ""), write=True)
    name = req.get("name", "")
    if op in ("mkdir", "rename") and (not name or "/" in name or name in (".", "..")):
        raise Fail("Invalid name.")
    if op == "mkdir":
        p = os.path.join(full, name)
        os.mkdir(p)
        os.chmod(p, 0o777)
        if not TEST:
            os.chown(p, owner_of(user), 500)
    elif op == "delete":
        if full == _b:
            raise Fail("The share itself remains.")
        if not os.path.lexists(full):
            raise Fail("Not found.", 404)
        rel = os.path.relpath(full, _b)
        if share_recycle(share) and rel.split("/")[0] != RECYCLE_DIR and not req.get("permanent"):
            to_recycle(_b, full)
            return {"recycled": True}
        if os.path.isdir(full) and not os.path.islink(full):
            shutil.rmtree(full)
        else:
            os.unlink(full)
    elif op == "rename":
        if full == _b:
            raise Fail("The share itself remains.")
        dst = os.path.join(os.path.dirname(full), name)
        if os.path.exists(dst):
            raise Fail("Name already exists.")
        os.rename(full, dst)
    else:
        raise Fail("Unknown action.")
    return {}


# ------------------------------------------------- copy / move (background jobs)

FILE_JOBS = {}                 # id -> job (memory; finished jobs are kept an hour)


def files_transfer(user, req):
    """Copy or move items (any shares the user may use) into a folder.
    conflict: rename (default, "name (2)"), overwrite, skip."""
    op, conflict = req.get("op"), req.get("conflict") or "rename"
    if op not in ("copy", "move") or conflict not in ("rename", "overwrite", "skip"):
        raise Fail("Unknown action.")
    dst = req.get("dst") or {}
    _db, dfull = resolve(user, str(dst.get("share") or ""), str(dst.get("path") or ""), write=True)
    if not os.path.isdir(dfull):
        raise Fail("The target is not a folder.", 404)
    items = []
    for it in (req.get("items") or [])[:5000]:
        b, f = resolve(user, str(it.get("share") or ""), str(it.get("path") or ""), write=(op == "move"))
        if f == b:
            raise Fail("A whole share cannot be copied or moved here; choose its contents.")
        if not os.path.lexists(f):
            raise Fail("Not found: %s" % it.get("path"), 404)
        if dfull == f or dfull.startswith(f + "/"):
            raise Fail("A folder cannot go into itself.")
        items.append(f)
    if not items:
        raise Fail("Nothing selected.")
    now = time.time()
    for k in [k for k, j in FILE_JOBS.items() if j["state"] != "running" and now - j["t"] > 3600]:
        del FILE_JOBS[k]
    jid = secrets.token_hex(6)
    job = {"id": jid, "user": user, "op": op, "state": "running", "total": 0, "done": 0, "files": 0, "current": "",
           "errors": [], "skipped": 0, "cancel": False, "t": now, "dst": str(dst.get("path") or "") or str(dst.get("share") or "")}
    FILE_JOBS[jid] = job
    threading.Thread(target=transfer_run, args=(job, items, dfull, conflict), daemon=True).start()
    return {"job": jid}


def transfer_run(job, items, dfull, conflict):
    class Cancelled(Exception):
        pass

    def err(msg):
        if len(job["errors"]) < 20:
            job["errors"].append(msg)

    def copy_file(src, dst):
        tmp = dst + ".untrash-part"
        try:
            with open(src, "rb") as fi, open(tmp, "wb") as fo:
                while True:
                    if job["cancel"]:
                        raise Cancelled()
                    b = fi.read(1 << 20)
                    if not b:
                        break
                    fo.write(b)
                    job["done"] += len(b)
            st = os.stat(src)
            os.utime(tmp, ns=(st.st_atime_ns, st.st_mtime_ns))
            own(tmp, job["user"])
            os.replace(tmp, dst)
            job["files"] += 1
        except BaseException:
            if os.path.exists(tmp):
                os.unlink(tmp)
            raise

    def copy_tree(src, dst):
        if os.path.islink(src):
            err("%s: links are not copied" % os.path.basename(src))
            return False
        if os.path.isdir(src):
            os.mkdir(dst)
            own(dst, job["user"])
            ok = True
            for e in sorted(os.listdir(src)):
                if e in (IMP.RECYCLE_FN, IMP.RECYCLE_RBM_FN):
                    continue
                job["current"] = e
                try:
                    ok = copy_tree(os.path.join(src, e), os.path.join(dst, e)) and ok
                except OSError as x:
                    err("%s: %s" % (e, x.strerror or x))
                    ok = False
            return ok
        copy_file(src, dst)
        return True

    def size(p):
        if os.path.islink(p):
            return 0
        if os.path.isfile(p):
            return os.path.getsize(p)
        t = 0
        for d, _ds, fs in os.walk(p):
            for f in fs:
                fp = os.path.join(d, f)
                if not os.path.islink(fp):
                    try:
                        t += os.path.getsize(fp)
                    except OSError:
                        pass
        return t

    try:
        job["total"] = sum(size(f) for f in items)
        for src in items:
            name = os.path.basename(src)
            job["current"] = name
            target = os.path.join(dfull, name)
            if job["op"] == "move" and os.path.dirname(src) == dfull:
                job["skipped"] += 1                  # moved onto itself: nothing to do
                continue
            if os.path.lexists(target):
                if conflict == "skip":
                    job["skipped"] += 1
                    continue
                if conflict == "rename" or target == src:
                    target = free_name(target)
                else:                                # overwrite: the old one goes
                    if os.path.isdir(target) and not os.path.islink(target):
                        shutil.rmtree(target)
                    else:
                        os.unlink(target)
            try:
                if job["op"] == "move":
                    try:
                        os.rename(src, target)       # same file system: instant
                        job["done"] += size(target)
                        job["files"] += 1
                        continue
                    except OSError as x:
                        if x.errno != 18:            # EXDEV: other volume, copy + delete
                            raise
                if copy_tree(src, target) and job["op"] == "move":
                    if os.path.isdir(src) and not os.path.islink(src):
                        shutil.rmtree(src)
                    else:
                        os.unlink(src)
            except OSError as x:
                err("%s: %s" % (name, x.strerror or x))
        job["state"] = "done" if not job["errors"] else "errors"
    except Cancelled:
        job["state"] = "cancelled"
    except Exception as x:  # noqa: BLE001 - a job must end with a state
        err(str(x))
        job["state"] = "errors"
    job["current"], job["t"] = "", time.time()


