STORAGE = os.environ.get("ZT_STORAGE_TOOL", "/usr/sbin/untrash-storage")
RAIDJOB = {"state": "idle", "op": "", "log": []}
RAID_OPS = ("create", "repair", "add-disks", "change-level", "add-spare", "remove-spare", "expand", "delete",
            "lv-create", "lv-extend", "lv-delete", "rename")
# typed confirmation: partitioning disks erases them, deleting erases a volume
RAID_CONFIRM = {"create": "FORMAT", "repair": "FORMAT", "add-disks": "FORMAT",
                "change-level": "FORMAT", "add-spare": "FORMAT", "delete": "DELETE", "lv-delete": "DELETE"}


def raid_status():
    try:
        st = json.loads(read([STORAGE, "status"], timeout=90) or "{}")
    except ValueError:
        st = {}
    st.setdefault("disks", [])
    st.setdefault("arrays", [])
    st["job"] = {"state": RAIDJOB["state"], "op": RAIDJOB["op"], "log": RAIDJOB["log"][-300:]}
    return st


def raid_job(req):
    """Starts one untrash-storage job in the background (stock: storage_main
    thread + lock file); the log is polled through /api/raid."""
    op = req.get("op", "")
    if op not in RAID_OPS:
        raise Fail("Unknown job.")
    if RAIDJOB["state"] == "running":
        raise Fail("A storage job is still running.")
    need = RAID_CONFIRM.get(op)
    if need and req.get("confirm") != need:
        raise Fail("Type %s to confirm." % need)
    args = {k: v for k, v in req.items() if k not in ("op", "confirm")}
    RAIDJOB.update(state="running", op=op, log=[time.strftime("%H:%M:%S ") + "Job " + op])

    def worker():
        rc = 1
        try:
            p = subprocess.Popen([STORAGE, "run", op, json.dumps(args)], stdout=subprocess.PIPE,
                                 stderr=subprocess.STDOUT, text=True)
            for line in p.stdout:
                RAIDJOB["log"].append(line.rstrip("\n"))
                del RAIDJOB["log"][:-2000]
            rc = p.wait()
        except OSError as e:
            RAIDJOB["log"].append("ERROR %s" % e)
        try:
            with LOCK:
                resmb()            # shares on a deleted volume left the database
        except (Fail, OSError) as e:
            RAIDJOB["log"].append("Samba: %s" % e)
        RAIDJOB["state"] = "done" if rc == 0 else "failed"

    threading.Thread(target=worker, daemon=True).start()
    return {"op": op}


# ------------------------------------------------------------- slot update

UPDATE = {"state": "idle", "log": []}
UPDATE_TOOL = os.environ.get("ZT_UPDATE_TOOL", "/usr/lib/untrash/untrash-update")
UPDATE_STATE = os.environ.get("ZT_UPDATE_STATE", R + "/var/lib/untrash/update/state.json")


def boot_env():
    try:
        return dict(l.rstrip("\n").split("=", 1) for l in open(R + "/run/untrash/boot.env") if "=" in l)
    except OSError:
        return {}


def update_upload(handler, length):
    """Body = a slot file (*.utslot, firmware install/mk-stick-system.sh); stored,
    signature + payload hashes checked by zt-loader's rules, written to the
    inactive slot, boot state prefers it once.  The loader falls back to the
    old slot if the new one never confirms itself (3 tries)."""
    if length <= 8192 or length > 1536 * 1024 * 1024:
        raise Fail("Not a system image file.")
    os.makedirs(UPLOAD_DIR, exist_ok=True)
    tmp = os.path.join(UPLOAD_DIR, "upload.utslot")
    with open(tmp, "wb") as f:
        left = length
        while left:
            b = handler.rfile.read(min(left, 1 << 20))
            if not b:
                raise Fail("Transfer aborted.")
            f.write(b)
            left -= len(b)
    try:
        m = untrash_slot.verify(tmp, check_signature=not TEST)
    except untrash_slot.SlotError as e:
        raise Fail(str(e))
    ver = m.get("version", "?")
    UPDATE.update(state="ready", version=ver, file=tmp, size=length, source="upload",
                  older=not untrash_slot.newer(ver, first("/etc/untrash-version", "?").strip()),
                  log=["Image %s checked (signature, kernel, DTB, initrd)" % ver])
    return {"version": UPDATE["version"]}


def update_release_state():
    try:
        return json.load(open(UPDATE_STATE))
    except (OSError, ValueError):
        return {}


def update_install(req):
    """Write a verified image to the inactive slot: the uploaded one, or
    (source=release) the one untrash-update downloaded.  An image that is not
    newer than the running system needs downgrade=true."""
    if req.get("source") == "release":
        st = update_release_state()
        f = (st.get("download") or {}).get("file") or ""
        if (st.get("download") or {}).get("state") != "ready" or not os.path.isfile(f):
            raise Fail("No downloaded update is ready.")
        try:
            m = untrash_slot.trailer(f)[0]  # verified after the download; the file is root's
        except untrash_slot.SlotError as e:
            raise Fail(str(e))
        UPDATE.update(state="ready", version=m.get("version", "?"), file=f, source="release",
                      older=not untrash_slot.newer(m.get("version", "?"), first("/etc/untrash-version", "?").strip()),
                      log=["Image %s downloaded from the release page and checked (signature, kernel, DTB, initrd)" % m.get("version", "?")])
    if UPDATE.get("state") != "ready":
        raise Fail("Upload an image first.")
    if UPDATE.get("older") and not req.get("downgrade"):
        raise Fail("This image is not newer than the running system (%s); confirm the downgrade." % first("/etc/untrash-version", "?").strip())
    env = boot_env()
    slot = env.get("ZT_SLOT") or ""
    other = "b" if slot == "a" else "a"
    f = UPDATE["file"]
    if env.get("ZT_BOOT") == "file":
        dst = "%s/.untrash/slot-%s.utslot" % (env.get("ZT_HOST", "/run/untrash/host"), other)
        sysrun(["cp", f, dst + ".new"])
        sysrun(["sync"])
        sysrun(["mv", dst + ".new", dst])
    else:
        part = read(["findfs", "PARTLABEL=ut-sys-" + other]).strip() or "PARTLABEL=ut-sys-" + other
        # head at the start of the partition, trailer in its last 8 KiB
        sysrun(["/usr/lib/untrash/untrash-slot-write", f, part])
    sysrun(["/usr/lib/untrash/untrash-bootstate", "prefer", other])
    UPDATE["log"].append("written to slot %s; restarting starts %s" % (other.upper(), UPDATE["version"]))
    UPDATE["state"] = "installed"
    return {"slot": other}


def update_run(args):
    """untrash-update in the background (check or download)."""
    if TEST:
        SYSLOG.append([UPDATE_TOOL] + args)
    threading.Thread(target=lambda: subprocess.run([UPDATE_TOOL] + args, stdout=subprocess.DEVNULL), daemon=True).start()
    return {}


def update_settings(req):
    s = settings_load()
    u = s.setdefault("update", {})
    for k in ("check", "download"):
        if k in req:
            u[k] = bool(req[k])
    if "channel" in req:
        if req["channel"] not in ("stable", "beta"):
            raise Fail("Unknown update channel.")
        u["channel"] = req["channel"]
