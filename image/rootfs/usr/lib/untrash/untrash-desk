def printers():
    """Known printers (untrash-printer table) with CUPS state and job count."""
    try:
        seen = json.load(open(R + "/var/lib/untrash/printers.json"))
    except (OSError, ValueError):
        seen = {}
    jobs = read(["lpstat", "-o"]).splitlines()
    out = []
    for serial, p in sorted(seen.items()):
        name = p.get("name", "")
