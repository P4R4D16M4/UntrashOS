def adblock_save(req):
    s = AB.load()
    restart = rebuild = False
    if "lists" in req:
        ls = []
        for x in req["lists"][:20]:
            url = str(x.get("url", "")).strip()
            if not re.fullmatch(r"https?://[^\s]{4,500}", url):
                raise Fail("Invalid list address: %s" % url[:80])
            ls.append({"name": str(x.get("name") or url)[:60], "url": url, "on": bool(x.get("on"))})
        rebuild = ls != s["lists"]
        s["lists"] = ls
    for k in ("allow", "block"):
        if k in req:
            vals = []
            for d in req[k][:500]:
                c = AB.clean_domain(d)
                if not c:
                    raise Fail("Invalid domain: %s" % str(d)[:80])
                if c not in vals:
                    vals.append(c)
            restart = restart or vals != s[k]
            rebuild = rebuild or (k == "allow" and vals != s[k])
            s[k] = vals
    AB.save(s)
    if rebuild:
        s["count"] = AB.build(s)
        AB.save(s)
        AB.reload_hosts()
    if "active" in req:
        os.makedirs(AB.DATA, exist_ok=True)
        if req["active"]:
            open(AB.FLAG, "w").close()
            first_lists = not s["updated"]
            sysrun(["systemctl", "restart", "--no-block", "untrash-adblock.service"], check=False)
            if first_lists:
                adblock_update({})
        else:
            if os.path.exists(AB.FLAG):
                os.unlink(AB.FLAG)
            sysrun(["systemctl", "stop", "--no-block", "untrash-adblock.service"], check=False)
    elif restart and os.path.exists(AB.FLAG):
        sysrun(["systemctl", "restart", "--no-block", "untrash-adblock.service"], check=False)
    AB_STATE["stats"] = None
    return adblock_state()


def adblock_update(_req):
    """Download the enabled lists in the background (minutes on a slow line)."""
    if AB_STATE["updating"]:
        return {}

    def run():
        try:
            if not TEST:
                subprocess.run(["nice", "-n", "10", AB.__file__, "update"], stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, timeout=1800)
            else:
                SYSLOG.append([AB.__file__, "update"])
        finally:
            AB_STATE["updating"] = False
    AB_STATE["updating"] = True
    threading.Thread(target=run, daemon=True).start()
    return {}


