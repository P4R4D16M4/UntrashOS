class Handler(BaseHTTPRequestHandler):
    server_version = "UntrashDesk"

    def reply(self, code, obj, ctype="application/json", headers=()):
        body = obj if isinstance(obj, bytes) else (obj.encode() if isinstance(obj, str) else json.dumps(obj).encode())
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("X-Content-Type-Options", "nosniff")
        if not any(k == "X-Frame-Options" for k, _v in headers):
            self.send_header("X-Frame-Options", "DENY")
        self.send_header("Referrer-Policy", "no-referrer")
        if not any(k == "Cache-Control" for k, _v in headers):
            self.send_header("Cache-Control", "no-store" if ctype == "application/json" or ctype.startswith("text/html")
                             else "max-age=3600")
        for k, v in headers:
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def json_body(self):
        if getattr(self, "raw_body", None) is not None:          # an app request: read (and signed) already
            try:
                return json.loads(self.raw_body or b"{}")
            except ValueError:
                raise Fail("Invalid JSON.")
        n = int(self.headers.get("Content-Length") or 0)
        if n > 1 << 20:
            raise Fail("Request too large.", 413)
        try:
            return json.loads(self.rfile.read(n) or b"{}") if n else {}
        except ValueError:
            raise Fail("Invalid JSON.")

    def handle_any(self, method):
        url = urllib.parse.urlsplit(self.path)
        p, q = url.path, dict(urllib.parse.parse_qsl(url.query))
        hs = HTTPS_STATE
        if hs.get("force") and not getattr(self.server, "tls", False):
            host = (self.headers.get("Host") or "").rsplit(":", 1)[0] or "localhost"
            self.send_response(301)
            self.send_header("Location", "https://%s%s%s" % (host, "" if hs["port"] == 443 else ":%d" % hs["port"], self.path))
            self.send_header("Content-Length", "0")
            self.end_headers()
            return
        if method == "GET" and p in ("/", "/index.html"):
            f = static(STATIC, "index.html")
            if not f:
                return self.reply(500, "desk files missing", "text/plain")
            # system language for i18n.js (a browser's own choice wins)
            lang = settings_load().get("language", "en")
            page = f[0].replace(b'<html lang="en">', b'<html lang="en" data-lang="%s">' % lang.encode())
            # cache busting: scripts and styles are cached for an hour, an
            # update (new slot) or a changed file must reach the browser at once
            ver = hashlib.sha1(("%s|%s" % (first("/etc/untrash-version", "?").strip(), "|".join(
                str(int(os.path.getmtime(x))) for x in (os.path.join(STATIC, "desk.js"), os.path.join(STATIC, "desk.css"),
                                                        os.path.join(DESIGN, "i18n", "i18n.js"), os.path.join(DESIGN, "untrash.css"),
                                                        os.path.join(DESIGN, "theme.js"))
                if os.path.exists(x)))).encode()).hexdigest()[:10].encode()
            page = re.sub(rb'((?:src|href)="/(?:desk|ut)/[^"?]+\.(?:js|css))"', rb'\1?v=' + ver + b'"', page)
            return self.reply(200, page, f[1])
        if method == "GET" and p.startswith("/desk/"):
            f = static(STATIC, p[len("/desk/"):])
            return self.reply(200, *f) if f else self.reply(404, {"error": "not found"})
        if method == "GET" and p.startswith("/ut/"):
            f = static(DESIGN, p[len("/ut/"):])
            return self.reply(200, *f) if f else self.reply(404, {"error": "not found"})
        if method == "GET" and p in ("/manual", "/manual/"):
            # readable without signing in, like the login page itself
            # static, no scripts: the Desk's "Manual" window shows it in a frame
            f = static(MANUAL, "index.html") or static(MANUAL, "manual.html")
            return self.reply(200, *f, headers=MANUAL_HDR) if f else self.reply(404, {"error": "not found"})
        if method == "GET" and p.startswith("/manual/"):
            f = static(MANUAL, p[len("/manual/"):])
            return self.reply(200, *f, headers=MANUAL_HDR) if f else self.reply(404, {"error": "not found"})
        if method == "GET" and p.lower().startswith("/myweb"):
            return self.webpublish(p)
        if p.startswith("/s/") and method in ("GET", "POST"):
            return self.share_link(p[3:], method)
        if p.startswith("/tv/") and method == "GET":
            return self.tv(p[4:])
        if p.startswith("/wopi/") and method in ("GET", "POST"):
            return wopi_handle(self, method, p[len("/wopi/"):], q)
        if not p.startswith("/api/"):
            return self.reply(404, {"error": "not found"})
        self.raw_body, self.app = None, None
        if (self.headers.get("Authorization") or "").startswith("UntrashApp "):
            if p in APP_STREAMED:
                raise Fail("Not available to the app in API version %d." % APP_API, 400)
            n = int(self.headers.get("Content-Length") or 0)
            if n > 1 << 20:
                raise Fail("Request too large.", 413)
            self.raw_body = self.rfile.read(n) if n else b""
            self.app = app_auth(self, method, self.raw_body)          # signed: no cookie, no CSRF token needed
        elif method == "POST" and self.headers.get("X-UT") != "1":
            raise Fail("Missing X-UT header (CSRF protection).", 403)
        if p == "/api/state":
            return self.reply(200, {"initialized": initialized(), "hostname": settings_load()["hostname"],
                                    "language": settings_load().get("language", "en"),
                                    "user": session_user(self), "reset_window": reset_window()})
        if p == "/api/reset-admin" and method == "POST":
            with LOCK:
                return self.reply(200, reset_admin(self.json_body()))
        if p == "/api/setup" and method == "POST":
            with LOCK:
                return self.reply(200, setup(self.json_body()))
        if p == "/api/login" and method == "POST":
            req = self.json_body()
            tok = login(self, req)
            if signin_mode(req["user"]) == "both":           # second factor: the app confirms
                SESSIONS.pop(tok, None)
                rid, code = app_request("login2", req["user"], self)
                return self.reply(200, {"second": rid, "code": code})
            return self.reply(200, {"ok": True}, headers=[("Set-Cookie", "utsess=%s; Path=/; HttpOnly; SameSite=Strict; Max-Age=%d" % (tok, SESSION_S))])
        if p == "/api/login/app" and method == "POST":
            # sign-in without password; created for any name, so the answer does
            # not tell whether the user exists or has an app (it just expires)
            ip = self.client_address[0]
            if FAILS.get(ip, (0, 0))[1] > time.time():
                raise Fail("Too many failed attempts, please wait %d s." % int(FAILS[ip][1] - time.time()), 429)
            name = str(self.json_body().get("user") or "")
            if not NAME_RE.match(name):
