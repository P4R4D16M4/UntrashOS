class Fail(Exception):
    def __init__(self, msg, code=400, extra=None):
        super().__init__(msg)
        self.code = code
        self.extra = extra or {}


def load_module(path, name):
    spec = importlib.util.spec_from_loader(name, importlib.machinery.SourceFileLoader(name, path))
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


IMP = load_module(IMPORT, "untrash_import_zyxel")


def sysrun(cmd, input=None, check=True):
    """System command (logged instead in test mode)."""
    if TEST:
        SYSLOG.append(cmd)
        return ""
    r = subprocess.run(cmd, input=input, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    out = r.stdout.decode("utf-8", "replace")
    if check and r.returncode:
        raise Fail("%s: %s" % (cmd[0], out.strip()[-300:]), 500)
    return out


def read(cmd, timeout=20):
    """Read-only command (also runs in test mode, empty on failure)."""
    try:
        r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=timeout)
        return r.stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


# ------------------------------------------------------------- stock database

def db():
    os.makedirs(CONFIG, mode=0o700, exist_ok=True)
    c = sqlite3.connect(DB)
    c.executescript(SCHEMA)
    return c


def initialized():
    if not os.path.isfile(DB):
        return False
    c = db()
    try:
        return c.execute("SELECT count(*) FROM smb_user WHERE uname='admin'").fetchone()[0] > 0
    finally:
        c.close()


def is_admin(user):
    if user in ("admin", "root"):
        return True
    c = db()
    try:
        return c.execute("SELECT count(*) FROM group_member WHERE uname=? AND gname=?",
                         (user, ADMIN_GROUP)).fetchone()[0] > 0
    finally:
        c.close()


def resmb():
    """smb.conf from the database, Samba reload (after every rights change)."""
    if TEST:
        stock = IMP.Stock(CONFIG)
        text, _s = IMP.render_smbconf(stock, path_exists=lambda p: True)
        os.makedirs(R + "/etc/samba", exist_ok=True)
        open(R + "/etc/samba/smb.conf", "w").write(text)
        SYSLOG.append(["smbcontrol", "smbd", "reload-config"])
        return
    sysrun([IMPORT, "render", CONFIG, "--out", "/etc/samba/smb.conf"])
    sysrun(["smbcontrol", "smbd", "reload-config"], check=False)
    sysrun([CFGTOOL, "shares-changed"], check=False)      # WebDAV rights follow the share rights


