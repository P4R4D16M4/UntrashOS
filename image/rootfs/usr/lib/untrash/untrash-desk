def is_host(d):
    try:
        return os.path.ismount(HOST_MNT) and os.stat(HOST_MNT).st_dev == os.stat(d).st_dev
    except OSError:
        return False


def volumes():
    """Mounted data volumes under /i-data (stock and ut-data) and /e-data."""
    out = []
    for root, kind in ((IDATA, "intern"), (EDATA, "usb")):
        for d in sorted(glob.glob(root + "/*")):
            n = os.path.basename(d)
            if n in ("sysvol", ".system", ".media") or os.path.islink(d) or not os.path.isdir(d):
                continue
            label = ""
            try:
                label = open(os.path.join(d, ".system", "name_label")).read().strip()
            except OSError:
                pass
            try:
                st = os.statvfs(d)
                size, free = st.f_blocks * st.f_frsize, st.f_bavail * st.f_frsize
            except OSError:
                size = free = 0
            if TEST and os.path.isfile(os.path.join(d, ".system", "test_df")):   # manual screenshots: demo sizes
                size, free = (int(x) for x in open(os.path.join(d, ".system", "test_df")).read().split()[:2])
            out.append({"id": n, "path": d.replace(R, "", 1), "kind": kind, "label": label or n,
                        "size": size, "free": free, "sysvol": os.path.realpath(IDATA + "/sysvol") == os.path.realpath(d),
                        "host": kind == "intern" and is_host(d)})
    # partner volumes: sizes measured by untrash-mesh (a mount of an unreachable
    # partner must never hang the Desk with statvfs here)
    try:
        pv = json.load(open(MESH_VOLUMES))
    except (OSError, ValueError):
        pv = {}
    for mp, v in sorted(pv.items()):
        if not v.get("mounted"):
            continue
        out.append({"id": "p:" + os.path.basename(mp), "path": PDATA.replace(R, "", 1) + "/" + os.path.basename(mp), "kind": "partner",
                    "label": "%s @ %s" % (v.get("share"), v.get("partner")), "size": v.get("size", 0), "free": v.get("free", 0),
                    "sysvol": False, "mode": v.get("mode"), "partner": v.get("partner")})
    return out


def shares():
    c = db()
    try:
        out = []
        for s_name, s_path, ctype, desc, en, br, rc, media, web in c.execute(
                "SELECT s_name, s_path, create_type, s_desc, s_enable, browseable, recycle, mdaserv_public_type, "
                "web_public FROM smb_share ORDER BY s_name COLLATE NOCASE"):
            out.append({"name": s_name, "path": s_path, "type": ctype, "description": desc or "",
                        "enabled": en == "y", "browseable": br == "y", "recycle": rc == "y", "media": media or 0,
                        "web_public": web == "y",
                        "present": os.path.isdir(R + s_path),
                        "users": dict(c.execute("SELECT uname, privilege FROM share_user_privilege WHERE s_name=?", (s_name,))),
                        "groups": dict(c.execute("SELECT gname, privilege FROM share_group_privilege WHERE s_name=?", (s_name,)))})
        return out
    finally:
        c.close()


def volume_dirs(q):
    """Folders below a volume (one level, for the folder picker); admins only."""
    vol = next((v for v in volumes() if v["id"] == q.get("volume")), None)
    if not vol:
        raise Fail("Choose a volume.")
    rel = "/".join(x for x in str(q.get("path") or "").split("/") if x not in ("", ".", ".."))
    base = os.path.realpath(R + vol["path"])
    full = os.path.realpath(os.path.join(base, rel))
    if full != base and not full.startswith(base + "/") or not os.path.isdir(full):
        raise Fail("Check the folder.")
    shared = {x["path"] for x in shares()}
    out = []
    for e in sorted(os.scandir(full), key=lambda e: e.name.lower()):
        if e.is_dir(follow_symlinks=False) and not e.name.startswith((".", "@")):
            p = vol["path"] + "/" + os.path.relpath(e.path, base)
            out.append({"name": e.name, "shared": next((x["name"] for x in shares() if x["path"] == p), None) if p in shared else None})
    return {"volume": vol["id"], "path": rel, "dirs": out}


def share_save(req):
    """Create (new=true) or update a share: description, flags, rights."""
    name = req.get("name", "")
    if not SHARE_RE.match(name) or name.lower() in ("global", "homes", "printers", "ipc$"):
        raise Fail("Invalid share name.")
    c = db()
    try:
        exists = c.execute("SELECT s_path FROM smb_share WHERE s_name=? COLLATE NOCASE", (name,)).fetchone()
        if req.get("new"):
            if exists:
                raise Fail("This share already exists.")
            vol = next((v for v in volumes() if v["id"] == req.get("volume")), None)
            if not vol:
                raise Fail("Choose a volume.")
            folder = "/".join(x for x in str(req.get("folder") or "").split("/") if x not in ("", ".", ".."))
            if folder:
                # an existing folder on the volume (any depth) becomes the share
                path = "%s/%s" % (vol["path"], folder)
                if not os.path.isdir(R + path) or os.path.islink(R + path):
                    raise Fail("Check the folder.")
                if any(x[0] == path for x in c.execute("SELECT s_path FROM smb_share")):
                    raise Fail("This folder is already shared.")
            else:
                path = "%s/%s" % (vol["path"], name)
            c.execute("INSERT INTO smb_share VALUES (?,?,?,?,?,?,?,?,?)",
                      (name, path, "user-create", "", "y", "y", "n", 0, "n"))
            if not folder:
                if not TEST:
                    os.makedirs(path, exist_ok=True)
                    os.chmod(path, 0o777)
                else:
                    os.makedirs(R + path, exist_ok=True)
        elif not exists:
            raise Fail("Unknown share.", 404)
        sets = {"s_desc": (req.get("description") or "")[:120],
                "s_enable": "y" if req.get("enabled", True) else "n",
                "browseable": "y" if req.get("browseable", True) else "n",
                "recycle": "y" if req.get("recycle", False) else "n",
                "mdaserv_public_type": int(req.get("media") or 0) & 7}
        if "web_public" in req:
            sets["web_public"] = "y" if req.get("web_public") else "n"
        c.execute("UPDATE smb_share SET %s WHERE s_name=?" % ", ".join("%s=?" % k for k in sets),
                  list(sets.values()) + [name])
        if "users" in req or "groups" in req or req.get("new"):
            ulist = req.get("users") or ({"admin": "rw"} if req.get("new") else {})
            glist = req.get("groups") or {}
            uids = dict(c.execute("SELECT uname, uid FROM smb_user"))
            gids = dict(c.execute("SELECT gname, gid FROM smb_group"))
            for u, p in list(ulist.items()) + list(glist.items()):
                if p not in ("rw", "ro", "deny"):
                    raise Fail("Right must be rw, ro or deny.")
            if any(u not in uids for u in ulist) or any(g not in gids for g in glist):
                raise Fail("Unknown user or group in the rights.")
            c.execute("DELETE FROM share_user_privilege WHERE s_name=?", (name,))
            c.execute("DELETE FROM share_group_privilege WHERE s_name=?", (name,))
            c.executemany("INSERT INTO share_user_privilege VALUES (?,?,?,?)",
                          [(name, uids[u], u, p) for u, p in sorted(ulist.items())])
            c.executemany("INSERT INTO share_group_privilege VALUES (?,?,?,?)",
                          [(name, gids[g], g, p) for g, p in sorted(glist.items())])
        c.commit()
    finally:
        c.close()
    resmb()
    media_sync()
    return {}


def share_delete(req):
    """Stock semantics: the share disappears, the folder and its data stay."""
    name = req.get("name", "")
    c = db()
    try:
        r = c.execute("SELECT create_type FROM smb_share WHERE s_name=?", (name,)).fetchone()
        if not r:
            raise Fail("Unknown share.", 404)
        if r[0] == "built-in":
            raise Fail("Built-in shares remain.")
        for t in ("smb_share", "share_user_privilege", "share_group_privilege"):
            c.execute("DELETE FROM %s WHERE s_name=?" % t, (name,))
        c.commit()
    finally:
        c.close()
    resmb()
    media_sync()
    return {}


def media_sync():
    """Media server shares follow the per-share media flags."""
    s = settings_load()
    s["services"]["mediaserver"]["shares"] = {x["name"]: x["media"] for x in shares() if x["enabled"] and x["media"]}
    settings_save(s, apply=False)


