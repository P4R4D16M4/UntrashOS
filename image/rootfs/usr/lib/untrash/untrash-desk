def redact(text):
    """Remove what identifies this NAS or its people from a report."""
    for rx, rep in REDACT:
        text = rx.sub(rep, text)
    words = {settings_load().get("hostname", "")} | {x["name"] for x in shares()}
    c = db()
    try:
        words |= {r[0] for r in c.execute("SELECT uname FROM smb_user")} | {r[0] for r in c.execute("SELECT gname FROM smb_group")}
    except sqlite3.Error:
        pass
    finally:
        c.close()
    for w in sorted((w for w in words if w and len(w) > 2 and w not in ("admin", "everyone", "nobody")), key=len, reverse=True):
        text = re.sub(r"(?<![\w-])%s(?![\w-])" % re.escape(w), "<NAME>", text)
    return text


