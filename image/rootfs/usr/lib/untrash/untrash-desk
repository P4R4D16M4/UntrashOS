def export_start(user, req):
    srcs = []
    for x in req.get("sources") or []:
        _b, full = resolve(user, x.get("share", ""), x.get("path", ""))
        if not os.path.exists(full):
            raise Fail("Not a file.", 404)
        srcs.append(full)
    if not srcs:
        raise Fail("At least one source.")
    t = req.get("target") or {}
    name = re.sub(r"[^\w .()-]", "_", (req.get("folder") or "UntrashOS-Export " + time.strftime("%Y-%m-%d %H-%M")))[:80].strip() or "Export"
    if t.get("usb"):
        d = next((x for x in usb_drives() if x["id"] == t["usb"]), None)
        if not d:
            raise Fail("Choose a USB target.")
        base = (R + d["mnt"]) if TEST else d["mnt"]
    else:
        base = resolve(user, t.get("share", ""), t.get("path", ""), write=True)[1]
    target = os.path.join(base, name)
    if any(target == s or target.startswith(s.rstrip("/") + "/") for s in srcs):
        raise Fail("The target must not be inside the source.")
    mode = "convert" if req.get("mode") == "convert" else "copy"
    job = {"sources": srcs, "target": target, "mode": mode, "video": req.get("video") or {}, "audio": req.get("audio") or {},
           "subs": bool(req.get("subs", True)), "container": "mkv" if req.get("container") == "mkv" else "mp4",
           "music": req.get("music") or {}}
    jid = secrets.token_hex(4)
    os.makedirs(EXPORT_DIR, exist_ok=True)
    json.dump(job, open(os.path.join(EXPORT_DIR, jid + ".json"), "w"))
    with EXPORT_LOCK:
        EXPORTS[jid] = {"id": jid, "owner": user, "state": "waiting", "percent": 0, "file": "", "eta_s": None, "errors": [],
                        "target": t.get("usb") and "USB" or t.get("share", ""), "folder": name, "mode": mode,
                        "files_total": 0, "created": int(time.time()), "proc": None}
        EXPORT_Q.append(jid)
        if len(EXPORT_Q) == 1 and not any(e["state"] == "running" for e in EXPORTS.values()):
            threading.Thread(target=export_worker, daemon=True).start()
    return {"id": jid}


def export_worker():
    while True:
        with EXPORT_LOCK:
            if not EXPORT_Q:
                return
            jid = EXPORT_Q.pop(0)
            e = EXPORTS.get(jid)
            if not e or e["state"] != "waiting":
                continue
            e["state"] = "running"
        p = subprocess.Popen(["nice", "-n", "10", EXPORT_TOOL, "run", os.path.join(EXPORT_DIR, jid + ".json")],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, start_new_session=True)
        e["proc"] = p
        for line in p.stdout:
            try:
                x = json.loads(line)
            except ValueError:
                continue
            if x.get("done"):
                e["errors"] = x.get("errors", [])
                e["files_total"] = x.get("files_total", 0)
            else:
                e.update(percent=x.get("percent", e["percent"]), file=x.get("file", ""), eta_s=x.get("eta_s"),
                         files_total=x.get("files_total", 0))
        rc = p.wait()
        e["proc"] = None
        if e["state"] == "running":
            e["state"] = "done" if rc == 0 else "failed"
            if rc == 0:
                e["percent"] = 100


def export_jobs(user):
    adm = is_admin(user)
    return {"jobs": [{k: v for k, v in e.items() if k != "proc"} for e in sorted(EXPORTS.values(), key=lambda x: -x["created"])
                     if adm or e["owner"] == user]}


def export_cancel(user, req):
    e = EXPORTS.get(req.get("id", ""))
    if not e or not (is_admin(user) or e["owner"] == user):
        raise Fail("Unknown job.", 404)
    if req.get("remove") and e["state"] in ("done", "failed", "cancelled"):
        EXPORTS.pop(e["id"], None)
        return {}
    if e["state"] in ("waiting", "running"):
        e["state"] = "cancelled"
        if e.get("proc"):
            try:
                os.killpg(e["proc"].pid, signal.SIGTERM)
            except OSError:
                pass
    return {}


