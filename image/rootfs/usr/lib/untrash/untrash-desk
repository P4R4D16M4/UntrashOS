IP4 = r"\d{1,3}(\.\d{1,3}){3}"


def settings_update(req):
    """Validated partial update from the Settings/Network/Services windows."""
    s = settings_load()
    if "language" in req:
        if req["language"] not in ("en", "de", "fr"):
            raise Fail("Unknown language.")
        s["language"] = req["language"]
    if "hostname" in req:
        if not re.fullmatch(r"[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?", req["hostname"]):
            raise Fail("Invalid host name.")
        if req["hostname"] != s["hostname"]:
            s["hostname_auto"] = False      # the admin's name, untrash-netname leaves it alone
        s["hostname"] = req["hostname"]
    nb = req.get("netbios")
    if nb:
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]{0,14}", nb.get("name", "")):
            raise Fail("NetBIOS name: up to 15 characters, letters, digits, hyphen.")
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9 _-]{0,14}", nb.get("workgroup", "")):
            raise Fail("Invalid workgroup.")
        s["netbios"].update({"name": nb["name"], "workgroup": nb["workgroup"],
                             "description": (nb.get("description") or "")[:48].replace('"', "")})
    t = req.get("time")
    if t:
        if not os.path.isfile(os.path.join(R + "/usr/share/zoneinfo" if TEST else "/usr/share/zoneinfo", t.get("timezone", ""))):
            raise Fail("Unknown time zone.")
        if not re.fullmatch(r"[A-Za-z0-9.-]{1,80}", t.get("ntp_server", "x")):
            raise Fail("Invalid NTP server.")
        s["time"].update({"timezone": t["timezone"], "ntp": bool(t.get("ntp")), "ntp_server": t.get("ntp_server")})
    n = req.get("network")
    if n:
        for ifn in ("eth0", "eth1"):
            c = n.get(ifn)
            if not c:
                continue
            if c.get("mode") == "static":
                if not re.fullmatch(IP4 + r"/\d{1,2}", c.get("address", "")) or \
                        (c.get("gateway") and not re.fullmatch(IP4, c["gateway"])):
                    raise Fail("%s: address as a.b.c.d/nn, gateway as a.b.c.d." % ifn)
            mtu = int(c.get("mtu") or 1500)
            if not 576 <= mtu <= 9000:
                raise Fail("MTU 576 to 9000.")
            s["network"][ifn] = {"mode": "static" if c.get("mode") == "static" else "dhcp",
                                 "address": c.get("address", "") if c.get("mode") == "static" else "",
                                 "gateway": c.get("gateway", "") if c.get("mode") == "static" else "", "mtu": mtu}
        if "bond" in n:
            bd = n["bond"]
            if bd.get("active") and bd.get("mode_ip") == "static" and (
                    not re.fullmatch(IP4 + r"/\d{1,2}", bd.get("address", "")) or
                    (bd.get("gateway") and not re.fullmatch(IP4, bd["gateway"]))):
                raise Fail("bond0: address as a.b.c.d/nn, gateway as a.b.c.d.")
            s["network"]["bond"].update({"active": bool(bd.get("active")), "mode": int(bd.get("mode", 1)) % 7,
                                         "mode_ip": "static" if bd.get("mode_ip") == "static" else "dhcp",
                                         "address": bd.get("address", "") if bd.get("mode_ip") == "static" else "",
                                         "gateway": bd.get("gateway", "") if bd.get("mode_ip") == "static" else ""})
        if "dns" in n:
            servers = [x for x in n["dns"].get("servers") or [] if x]
            if any(not re.fullmatch(IP4, x) for x in servers):
                raise Fail("DNS server as a.b.c.d.")
            s["network"]["dns"] = {"auto": bool(n["dns"].get("auto")), "servers": servers}
    sv = req.get("services")
    if sv:
        cur = s["services"]
        if "ssh" in sv:
            cur["ssh"].update({k: sv["ssh"][k] for k in ("active", "sftp") if k in sv["ssh"]})
            if "port" in sv["ssh"]:
                cur["ssh"]["port"] = int(sv["ssh"]["port"])
        if "ftp" in sv:
            for k in ("active", "anonymous", "tls"):
                if k in sv["ftp"]:
                    cur["ftp"][k] = bool(sv["ftp"][k])
            for k in ("port", "conn_limit", "idle_min", "pasv_min", "pasv_max", "up_kbs", "down_kbs",
                      "anon_up_kbs", "anon_down_kbs"):
                if k in sv["ftp"]:
                    cur["ftp"][k] = max(0, int(sv["ftp"][k]))
        if "nfs" in sv:
            cur["nfs"]["active"] = bool(sv["nfs"].get("active", cur["nfs"]["active"]))
            if "exports" in sv["nfs"]:
                ex = []
                for e in sv["nfs"]["exports"]:
                    if not re.fullmatch(r"/[^\s]+", e.get("path", "")) or not re.fullmatch(r"[\w.*/:-]+", e.get("clients", "")):
                        raise Fail("NFS: check path and clients.")
                    ex.append({"path": e["path"], "clients": e["clients"],
                               "options": "ro,sync,no_subtree_check" if e.get("readonly") else "rw,sync,no_subtree_check"})
                cur["nfs"]["exports"] = ex
        if "mediaserver" in sv:
            cur["mediaserver"]["active"] = bool(sv["mediaserver"].get("active"))
        if "time_machine" in sv:
            tm = sv["time_machine"]
            if tm.get("active") and tm.get("share") not in [x["name"] for x in shares()]:
                raise Fail("Time Machine: choose a share.")
            cur["time_machine"] = {"active": bool(tm.get("active")), "share": tm.get("share", "")}
        if "webdav" in sv:
            cur["webdav"] = {"active": bool(sv["webdav"].get("active")), "anonymous": bool(sv["webdav"].get("anonymous"))}
        if "dyndns" in sv:
            d = sv["dyndns"]
            cfg = load_module(CFGTOOL, "untrash_config")
            if d.get("active"):
                if d.get("provider") not in cfg.DYNDNS:
                    raise Fail("DynDNS: choose a provider.")
                if not re.fullmatch(r"[A-Za-z0-9.-]{1,253}", d.get("hostname", "")):
                    raise Fail("DynDNS: check the host name.")
            cur["dyndns"].update({k: str(d.get(k, cur["dyndns"][k]))[:128] for k in ("provider", "username", "hostname")})
            cur["dyndns"]["active"] = bool(d.get("active"))
            if d.get("password"):
                cur["dyndns"]["password"] = str(d["password"])[:128]
        if "webpublish" in sv:
            port = int(sv["webpublish"].get("port") or 80)
            if not (port == 80 or 1024 <= port <= 65535) or port in (5002, 5003):
                raise Fail("Web Publishing: port 80 or 1024 to 65535 (not 5002/5003).")
            cur["webpublish"] = {"active": bool(sv["webpublish"].get("active")), "port": port}
        if "download" in sv:
            d, cd = sv["download"], cur["download"]
            if d.get("share") and d["share"] not in [x["name"] for x in shares()]:
                raise Fail("Downloads: choose a share.")
            if d.get("period") and not re.fullmatch(r"([01]\d|2[0-3])[0-5]\d:([01]\d|2[0-3])[0-5]\d", d["period"]):
                raise Fail("Time window as HHMM:HHMM (e.g. 0100:0700).")
            clean = lambda p: "/".join(x for x in str(p).split("/") if x not in ("", ".", ".."))[:200]  # noqa: E731
            cd.update({"active": bool(d.get("active", cd["active"])), "share": d.get("share", cd["share"]),
                       "folder": clean(d.get("folder", cd["folder"])), "incoming": clean(d.get("incoming", cd["incoming"])),
                       "bt_port": max(1024, min(65535, int(d.get("bt_port", cd["bt_port"])))),
                       "dht": bool(d.get("dht", cd["dht"])), "dl_kbs": max(0, int(d.get("dl_kbs", cd["dl_kbs"]))),
                       "up_kbs": max(0, int(d.get("up_kbs", cd["up_kbs"]))),
                       "slots": max(1, min(10, int(d.get("slots", cd["slots"])))),
                       "max_conn": max(2, min(450, int(d.get("max_conn", cd["max_conn"])))),
                       "ratio": max(-1, min(10000, int(d.get("ratio", cd["ratio"])))),
                       "seed_min": max(-1, int(d.get("seed_min", cd["seed_min"]))), "period": d.get("period", cd["period"]),
                       "notify": bool(d.get("notify", cd["notify"]))})
        if "https" in sv:
            hp = int(sv["https"].get("port") or 443)
            if not (hp == 443 or 1024 <= hp <= 65535) or hp in (5002, 5003):
                raise Fail("HTTPS port: 443 or 1024 to 65535.")
            if sv["https"].get("active") and not os.path.isfile(TLS_DIR + "/untrash.crt"):
                raise Fail("First create or upload a certificate (Settings → Certificate).")
            new = {"active": bool(sv["https"].get("active")), "port": hp, "force": bool(sv["https"].get("force"))}
            if new != cur["https"]:
                cur["https"] = new
                restart_desk()
        if "printer" in sv:
            cur["printer"]["active"] = bool(sv["printer"].get("active"))
        if "ups" in sv:
            cur["ups"] = {"active": bool(sv["ups"].get("active")),
                          "min_capacity": max(1, min(95, int(sv["ups"].get("min_capacity") or 5)))}
        if "syslog_server" in sv:
            ss = sv["syslog_server"]
            path = cur["syslog_server"]["path"]
            if ss.get("share"):
                m = {x["name"]: x["path"] for x in shares()}
                if ss["share"] not in m:
                    raise Fail("Syslog server: choose a share.")
                path = m[ss["share"]].rstrip("/") + "/" + re.sub(r"[^A-Za-z0-9._-]", "", ss.get("folder") or "syslog") + "/"
            if ss.get("active") and not path:
                raise Fail("Syslog server: choose a share.")
            cur["syslog_server"] = {"active": bool(ss.get("active")), "path": path,
                                    "format": ss.get("format") if ss.get("format") in ("simple", "full") else "simple",
                                    "months": max(1, min(60, int(ss.get("months") or 6)))}
    cb = req.get("copybtn")
    if cb:
        paths = {x["name"]: x["path"] for x in shares()}
        dirs = {"copy": ("cp2Vol", "cp2USB"), "sync": ("sync2USB", "sync2Vol", "twoWay")}
        for kind in ("copy", "sync"):
            c = cb.get(kind)
            if c is None:
                continue
            for k in ("share", "bak_share"):
                if c.get(k) and c[k] not in paths:
                    raise Fail("COPY button: choose a share.")
            if c.get("share") and c.get("share") == c.get("bak_share"):
                raise Fail("COPY button: the backup folder must be another share.")
            if c.get("direction") not in dirs[kind]:
                raise Fail("COPY button: check the direction.")
            cur = s["copybtn"][kind]
            cur.update({"share_path": paths.get(c.get("share"), ""), "bak_path": paths.get(c.get("bak_share"), ""),
                        "direction": c["direction"]})
            if kind == "copy":
                cur["newdir"] = bool(c.get("newdir")) and not c.get("bak_share")
    nt = req.get("notify")
    if nt:
        mail = nt.get("mail")
        if mail is not None:
            m = s["notify"]["mail"]
            addr = r"[^@\s,;]+@[^@\s,;]+\.[^@\s,;]+"
            for k in ("alerts_to", "log_to"):
                v = (mail.get(k) or "").strip()
                if v and not re.fullmatch(r"%s(\s*[,;]\s*%s)*" % (addr, addr), v):
                    raise Fail("Check the e-mail address: %s" % v)
                m[k] = v
            if mail.get("from") and not re.fullmatch(addr, mail["from"].strip()):
                raise Fail("Check the sender address.")
            if mail.get("active") and not re.fullmatch(r"[A-Za-z0-9.-]{1,253}", mail.get("server", "")):
                raise Fail("Check the mail server.")
            if mail.get("schedule", "daily") not in ("hourly", "daily", "weekly"):
                raise Fail("Schedule: hourly, daily or weekly.")
            m.update({"active": bool(mail.get("active")), "server": mail.get("server", m["server"]).strip(),
                      "port": max(0, min(65535, int(mail.get("port") or 0))), "auth": bool(mail.get("auth")),
                      "username": str(mail.get("username", m["username"]))[:128], "from": (mail.get("from") or "").strip(),
                      "subject": str(mail.get("subject", m["subject"]))[:64].replace("\n", " "),
                      "alerts": bool(mail.get("alerts")), "report_all": bool(mail.get("report_all")),
                      "schedule": mail.get("schedule", m["schedule"]), "day": int(mail.get("day", m["day"])) % 7,
                      "hour": int(mail.get("hour", m["hour"])) % 24, "minute": int(mail.get("minute", m["minute"])) % 60})
            if mail.get("password"):
                m["password"] = str(mail["password"])[:256]
        lg = nt.get("syslog")
        if lg is not None:
            if lg.get("active") and not re.fullmatch(r"[A-Za-z0-9.:-]{1,253}", lg.get("server", "")):
                raise Fail("Check the syslog server address.")
            s["notify"]["syslog"] = {"active": bool(lg.get("active")), "server": (lg.get("server") or "").strip(),
                                     "port": max(1, min(65535, int(lg.get("port") or 514)))}
    p = req.get("power")
    if p:
        if "spindown_min" in p:
            s["power"]["spindown_min"] = max(0, min(600, int(p.get("spindown_min", 0))))
        if "pwron" in p:
            if p["pwron"] not in ("always", "never", "former"):
                raise Fail("After a power failure: always, never or as before.")
            s["power"]["pwron"] = p["pwron"]
        if "wol" in p:
            s["power"]["wol"] = bool(p["wol"])
        if "schedule_active" in p:
            s["power"]["schedule_active"] = bool(p["schedule_active"])
        if "schedule" in p:
            sched = []
            for e in p["schedule"] or []:
                if e.get("action") not in ("on", "off", "reboot") or e.get("kind") not in ("daily", "weekly", "monthly"):
                    raise Fail("Schedule: check action and repetition.")
                x = {"action": e["action"], "kind": e["kind"], "hour": int(e.get("hour", 0)), "minute": int(e.get("minute", 0))}
                if not (0 <= x["hour"] <= 23 and 0 <= x["minute"] <= 59):
                    raise Fail("Schedule: check the time.")
                if e["kind"] == "weekly":
                    x["day"] = int(e.get("day", 0)) % 7
                if e["kind"] == "monthly":
                    x["mday"] = max(1, min(28, int(e.get("mday", 1))))
                sched.append(x)
            if len(sched) > 30:
                raise Fail("At most 30 schedule entries.")
            s["power"]["schedule"] = sched
    rc = req.get("recycle")
    if rc:
        s["recycle"]["expire_days"] = max(0, min(3650, int(rc.get("expire_days", 0))))
    settings_save(s)
    if nb or (sv and "time_machine" in sv):
        resmb()
    return {}


